.page {
  padding-bottom: 160rpx;
}

.hero {
  background: linear-gradient(135deg, #E86A17 0%, #F2913F 100%);
  padding: 40rpx 30rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-top: 10rpx;
}

.hero-search {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF4EC;
  color: #C05510;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 上次点菜的地方 */
.resume {
  margin: 24rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #FBE0CB;
}

.resume-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #FDEEE2;
  color: #E86A17;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}

.resume-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.resume-label {
  font-size: 22rpx;
  color: #B08A6C;
}

.resume-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-go {
  font-size: 25rpx;
  color: #E86A17;
  flex-shrink: 0;
}

.section-title {
  padding: 32rpx 32rpx 14rpx;
  font-size: 28rpx;
  color: #5C646E;
  font-weight: 600;
}

.hint {
  margin: 0 24rpx;
  padding: 44rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 26rpx;
  line-height: 1.7;
}

.hint-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B4B9C0;
}

/* 进行中的点单 */
.ocard {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.ocard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocard-kitchen {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
}

.ocard-line {
  font-size: 25rpx;
  color: #5C646E;
  margin-top: 12rpx;
}

.ocard-dim {
  color: #9AA1A9;
  font-size: 24rpx;
}

.status {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.st-wait {
  color: #B4610F;
  background: #FFF4E8;
}

.st-ack {
  color: #1D6FA5;
  background: #EAF3FB;
}

.st-doing {
  color: #1D9E75;
  background: #E9F7F1;
}

.st-done {
  color: #5C646E;
  background: #EFF1F4;
}

.st-off {
  color: #A32D2D;
  background: #FCEBEB;
}

/* 厨房卡片 */
.kcard {
  margin: 0 24rpx 20rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.kcard-dim {
  opacity: 0.72;
}

.kcard-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #FDEEE2;
  color: #E86A17;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
  flex-shrink: 0;
}

.kcard-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.kcard-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-sub {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-tags {
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #1D9E75;
  background: #E9F7F1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.kcard-go {
  font-size: 25rpx;
  color: #E86A17;
  flex-shrink: 0;
  padding-left: 12rpx;
}

.list-foot {
  margin: 8rpx 24rpx 0;
  font-size: 23rpx;
  color: #A6ACB4;
  text-align: center;
  line-height: 1.7;
}

.actions {
  padding: 8rpx 32rpx 0;
}
