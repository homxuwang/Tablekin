.hero {
  padding: 36rpx 32rpx 28rpx;
  background: #FFFFFF;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #23282F;
}

.hero-sub {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FDECEC;
  color: #C0392B;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.alert {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFF4E8;
  border: 2rpx solid #F8D9BC;
  border-radius: 18rpx;
}

.alert-title {
  font-size: 26rpx;
  color: #B4610F;
  font-weight: 600;
}

.alert-chips {
  margin-top: 12rpx;
}

.alert-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #B4610F;
  margin: 8rpx 12rpx 0 0;
}

.panel {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
}

.panel-action {
  font-size: 26rpx;
  color: #E86A17;
}

.field-note {
  padding: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #8A9099;
  line-height: 1.6;
}

.form-actions {
  padding: 24rpx 30rpx 30rpx;
}

.hint {
  padding: 40rpx 30rpx;
  font-size: 26rpx;
  color: #9AA1A9;
  line-height: 1.7;
}

.item {
  padding: 26rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #23282F;
  flex: 1;
  min-width: 0;
}

.item-stock {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.stock-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D9E75;
}

.stock-low {
  color: #D64545;
}

.stock-unit {
  font-size: 24rpx;
  color: #8A9099;
  margin-left: 6rpx;
}

.item-warn {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #B4610F;
}

.item-tools {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.tool {
  font-size: 26rpx;
  color: #5C646E;
  background: #F3F4F6;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 14rpx 0 0;
}

.tool-danger {
  color: #D64545;
  background: #FCEBEB;
}

.log {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.log:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-reason {
  font-size: 28rpx;
  color: #23282F;
}

.log-time {
  font-size: 22rpx;
  color: #9AA1A9;
  margin-top: 6rpx;
}

.log-change {
  font-size: 30rpx;
  font-weight: 600;
  width: 140rpx;
  text-align: right;
}

.log-up {
  color: #1D9E75;
}

.log-down {
  color: #D64545;
}

.log-balance {
  font-size: 24rpx;
  color: #8A9099;
  width: 160rpx;
  text-align: right;
}

.actions {
  padding: 32rpx 24rpx 60rpx;
}

.actions > view + view {
  margin-top: 20rpx;
}
