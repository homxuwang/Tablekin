.page {
  padding-bottom: 200rpx;
}

.top-head {
  padding: 20rpx 28rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.top-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.top-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #1F1A17;
  letter-spacing: -0.5rpx;
}

.top-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  line-height: 1.5;
}

.top-join {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFF1E5;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.14s ease;
}

.top-join:active {
  transform: scale(0.94);
}

.search-wrap {
  padding: 24rpx 24rpx 0;
}

.search-pill {
  height: 88rpx;
  padding: 0 14rpx 0 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(42, 28, 16, 0.05);
  display: flex;
  align-items: center;
}

.search-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #9E938A;
  margin-left: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-tag {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FAF5EE;
  color: #685E56;
  font-size: 23rpx;
  font-weight: 600;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  color: #B84C0E;
  border: 1rpx solid #F8D3B4;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 特色继续点菜卡：深咖色主视觉 */
.resume-hero {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 26rpx 28rpx 32rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 86% 20%, rgba(242, 134, 54, 0.34) 0%, rgba(242, 134, 54, 0) 58%),
    linear-gradient(135deg, #27201C 0%, #3A2E27 100%);
  box-shadow: 0 16rpx 36rpx rgba(31, 22, 16, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.14s ease;
}

.resume-hero:active {
  transform: scale(0.985);
}

.resume-body {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.resume-kicker {
  font-size: 21rpx;
  font-weight: 600;
  color: #F4A96B;
  letter-spacing: 1rpx;
}

.resume-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-cta {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.34);
}

.resume-art {
  width: 146rpx;
  height: 146rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
}

.sec-head {
  padding: 36rpx 28rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.sec-count {
  font-size: 23rpx;
  font-weight: 500;
  color: #9E938A;
}

/* 横滑进行中订单 */
.ongoing-scroll {
  width: 100%;
  white-space: nowrap;
}

.ongoing-row {
  display: inline-flex;
  padding: 4rpx 24rpx 8rpx;
}

.ocard {
  width: 580rpx;
  margin-right: 18rpx;
  padding: 26rpx 28rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.05);
  white-space: normal;
  flex-shrink: 0;
}

.ocard-full {
  width: 702rpx;
  margin-right: 0;
}

.ocard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocard-kitchen {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}

.ocard-line {
  font-size: 26rpx;
  color: #544B44;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ocard-bars {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.obar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: #EFEAE2;
  margin-right: 8rpx;
}

.obar:last-child {
  margin-right: 0;
}

.obar-on {
  background: linear-gradient(90deg, #E2621A 0%, #F28536 100%);
}

.ocard-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #9E938A;
}

.status {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  flex-shrink: 0;
}

.st-wait { color: #C2670E; background: #FEF4E6; }
.st-ack { color: #2563EB; background: #EDF4FF; }
.st-doing { color: #158059; background: #EAF8F1; }
.st-done { color: #685E56; background: #F2EFEA; }
.st-off { color: #C83737; background: #FEEFEF; }

/* 2 列发现厨房卡片网格 */
.kgrid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.kcard {
  width: 342rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.048);
  display: flex;
  flex-direction: column;
  transition: transform 0.14s ease;
}

.kcard:active {
  transform: scale(0.97);
}

.kcard-dim {
  opacity: 0.72;
}

.kcard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kcard-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.22);
}

.kcard-pill {
  font-size: 20rpx;
  font-weight: 600;
  color: #158059;
  background: #EAF8F1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.kcard-pill-dim {
  color: #9E938A;
  background: #F4EFE8;
}

.kcard-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  margin-top: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-sub {
  font-size: 23rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  line-height: 1.48;
  height: 68rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.kcard-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F4EFE8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kcard-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
}

.kcard-arrow {
  font-size: 28rpx;
  color: #DF5E16;
  font-weight: 600;
}

.hint {
  margin: 0 24rpx;
  padding: 56rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #8F847B;
  font-size: 27rpx;
  line-height: 1.75;
}

.hint-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ADA299;
}

.list-foot {
  margin: 14rpx 32rpx 0;
  font-size: 23rpx;
  color: #ADA299;
  text-align: center;
  line-height: 1.7;
}

.actions {
  padding: 20rpx 32rpx 0;
}
