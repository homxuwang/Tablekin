.sort-page { height: 100vh; display: flex; flex-direction: column; background: #F7F4EF; }
.sort-header { flex-shrink: 0; padding: 32rpx 28rpx 24rpx; }
.sort-title { font-size: 38rpx; font-weight: 700; color: #1F1A17; }
.sort-count { font-size: 24rpx; font-weight: 500; color: #8F847B; margin-left: 12rpx; }
.sort-hint { font-size: 24rpx; line-height: 1.6; color: #8F847B; margin-top: 10rpx; }
.sort-error { margin-top: 16rpx; background: #FFF3E8; border: 1rpx solid #F8D3B4; color: #B84C0E; padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.6; }
.sort-reload { color: #DF5E16; font-weight: 600; padding: 12rpx; text-decoration: underline; }
.sort-scroll { flex: 1; height: 0; min-height: 0; background: #FFFFFF; border-radius: 28rpx 28rpx 0 0; box-shadow: 0 -4rpx 20rpx rgba(42, 28, 16, 0.04); }
.sort-row { display: flex; align-items: center; height: 112rpx; box-sizing: border-box; padding-right: 20rpx; border-bottom: 1rpx solid #F2ECE4; }
.sort-handle { flex-shrink: 0; width: 84rpx; height: 100%; display: flex; align-items: center; justify-content: center; color: #B4AAA0; font-size: 32rpx; }
.sort-number { width: 48rpx; color: #9E938A; font-size: 22rpx; font-weight: 600; }
.sort-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 600; color: #1F1A17; }
.sort-action { flex-shrink: 0; margin: 0 0 0 10rpx; padding: 0 18rpx; font-size: 24rpx; font-weight: 600; line-height: 62rpx; background: #FFF2E6; color: #C25A14; border-radius: 12rpx; }
.sort-action[disabled] { color: #C8BFB6; background: #F5F1EB; }
.sort-placeholder { background: #FFF3E8; opacity: 0.3; }
.sort-ghost { position: fixed; left: 16rpx; right: 16rpx; z-index: 10; background: #FFF5EC; box-shadow: 0 10rpx 30rpx rgba(70,45,20,0.16); border: 2rpx solid #DF5E16; border-radius: 18rpx; display: flex; align-items: center; pointer-events: none; box-sizing: border-box; }
.sort-ghost-hint { color: #C25A14; font-size: 23rpx; font-weight: 600; padding: 0 20rpx; }
.sort-empty { flex: 1; text-align: center; color: #9E938A; padding: 60rpx 24rpx; }
.sort-footer { flex-shrink: 0; background: rgba(255, 253, 249, 0.96); padding: 20rpx 28rpx 24rpx; padding-bottom: calc(24rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #EFEAE2; }
.sort-status { font-size: 23rpx; color: #8F847B; text-align: center; margin-bottom: 16rpx; }
.sort-buttons { display: flex; }
.sort-cancel, .sort-save { font-size: 28rpx; font-weight: 600; border-radius: 999rpx; margin: 0; line-height: 84rpx; }
.sort-cancel { width: 32%; color: #685E56; background: #EFEAE2; }
.sort-save { flex: 1; margin-left: 20rpx; background: linear-gradient(135deg, #E2621A 0%, #F18335 100%); color: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(223, 94, 22, 0.24); }
.sort-save[disabled] { color: #FFFFFF; background: #EBB58F; box-shadow: none; }
