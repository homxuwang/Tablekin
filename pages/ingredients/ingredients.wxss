.page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.top-head {
  padding: 20rpx 28rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.top-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.top-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1A17;
  letter-spacing: -0.4rpx;
}

.top-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
}

.sub-warn {
  color: #C2670E;
  font-weight: 600;
}

.top-add {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFF1E5;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FEF0F0;
  border: 1rpx solid #F8CBCB;
  color: #C83737;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.pending-card {
  margin: 22rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #27201C 0%, #3A2E27 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 28rpx rgba(31, 26, 23, 0.16);
}

.pending-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.pending-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #F49242;
}

.pending-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.pending-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #DF5E16;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.alert {
  margin: 22rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF2E5 100%);
  border: 1.5rpx solid #F6CFAF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(223, 94, 22, 0.07);
}

.alert-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-title {
  font-size: 27rpx;
  color: #C2670E;
  font-weight: 700;
}

.alert-go {
  font-size: 23rpx;
  font-weight: 600;
  color: #DF5E16;
}

.alert-chips {
  margin-top: 12rpx;
}

.alert-chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #C2670E;
  background: #FFFFFF;
  border: 1rpx solid #F5D5B8;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 8rpx 10rpx 0 0;
}

.toolbar {
  margin: 24rpx 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(60, 42, 24, 0.08);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(42, 28, 16, 0.03);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1F1A17;
  padding: 0 14rpx;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #D6CEC5;
  color: #FFFFFF;
  font-size: 24rpx;
}

.filter-pills {
  display: flex;
  margin-top: 16rpx;
}

.fpill {
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #EFEAE2;
  color: #7A6E65;
  font-size: 24rpx;
  font-weight: 500;
}

.fpill-on {
  background: #1F1A17;
  color: #FFFFFF;
  font-weight: 600;
}

.panel {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  overflow: hidden;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.panel-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
}

.panel-action {
  font-size: 25rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.field-note {
  padding: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #8F847B;
  line-height: 1.6;
}

.form-actions {
  padding: 20rpx 30rpx 30rpx;
}

.hint {
  padding: 46rpx 30rpx;
  font-size: 26rpx;
  color: #9E938A;
  text-align: center;
  line-height: 1.7;
}

.hint-link {
  margin-top: 14rpx;
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF1E5;
  color: #DF5E16;
  font-size: 24rpx;
  font-weight: 600;
}

.item {
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.item-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.status-ok {
  color: #158059;
  background: #E8F6F0;
}

.status-low {
  color: #C2670E;
  background: #FFF1E3;
}

.status-out {
  color: #C93A3A;
  background: #FEF0F0;
}

.item-stock {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.stock-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #158059;
}

.stock-low {
  color: #C93A3A;
}

.stock-unit {
  font-size: 23rpx;
  color: #8F847B;
  margin-left: 6rpx;
}

.stock-track {
  margin-top: 14rpx;
  height: 8rpx;
  background: #F1ECE5;
  border-radius: 999rpx;
  overflow: hidden;
}

.stock-fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill-ok {
  background: linear-gradient(90deg, #1E9E6E 0%, #34C48B 100%);
}

.fill-low {
  background: linear-gradient(90deg, #E2621A 0%, #F59E3D 100%);
}

.fill-out {
  background: #D64545;
}

.item-warn {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: #C2670E;
}

.item-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.act-primary-group {
  display: flex;
  align-items: center;
}

.act-btn {
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  transition: transform 0.14s ease;
}

.act-btn:active {
  transform: scale(0.94);
}

.act-in {
  color: #DF5E16;
  background: #FFF1E5;
  border: 1.5rpx solid #F4CCB0;
}

.act-check {
  color: #5C534C;
  background: #FAF7F2;
  border: 1.5rpx solid #EAE2D9;
}

.act-secondary-group {
  display: flex;
  align-items: center;
}

.act-link {
  font-size: 24rpx;
  color: #8A7E74;
  padding: 8rpx 12rpx;
}

.act-danger {
  color: #C93A3A;
}

/* ---------- 库存明细底部抽屉 ---------- */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(24, 19, 15, 0.45);
  z-index: 60;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-card {
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 74vh;
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E2DBD2;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 22rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.sheet-close {
  font-size: 26rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.sheet-body {
  max-height: 56vh;
}

.log {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.log:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.log-reason {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1A17;
}

.log-time {
  font-size: 22rpx;
  color: #9E938A;
  margin-top: 6rpx;
}

.log-right {
  text-align: right;
  flex-shrink: 0;
}

.log-change {
  font-size: 30rpx;
  font-weight: 700;
}

.log-up {
  color: #158059;
}

.log-down {
  color: #C93A3A;
}

.log-balance {
  font-size: 22rpx;
  color: #8F847B;
  margin-top: 4rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(60, 42, 24, 0.08);
  z-index: 20;
}

.dock-btn {
  width: 100%;
}
