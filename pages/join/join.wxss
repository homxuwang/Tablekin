.page {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #E86A17 0%, #F2913F 100%);
  padding: 52rpx 32rpx 46rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}

.hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 14rpx;
  line-height: 1.7;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF4EC;
  color: #C05510;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx;
  overflow: hidden;
}

.code {
  font-size: 34rpx;
  color: #E86A17;
  letter-spacing: 6rpx;
  font-weight: 600;
}

.done {
  padding: 48rpx 32rpx;
  text-align: center;
}

.done-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #23282F;
}

.done-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8A9099;
}

.actions {
  padding: 8rpx 32rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost {
  margin-bottom: 20rpx;
}
