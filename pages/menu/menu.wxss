.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6F8;
}

.header {
  background: #FFFFFF;
  padding: 24rpx 32rpx 20rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  color: #23282F;
}

.subtitle {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

/* 放大镜：在菜单页也能直接搜这个厨房的菜、或者搜别的厨房 */
.header-search {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  border-radius: 50%;
  background: #FDEEE2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-tools {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.header-btn {
  font-size: 26rpx;
  color: #E86A17;
  border: 2rpx solid #F3C9A8;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
}

.header-btn-soft {
  color: #6B727B;
  border-color: #E5E7EA;
}

.banner {
  margin: 16rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #FDECEC;
  color: #C0392B;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.banner-go {
  margin-top: 14rpx;
  color: #E86A17;
  font-size: 26rpx;
}

.notice {
  margin: 16rpx 32rpx 0;
  padding: 18rpx 24rpx;
  background: #FFF4E8;
  color: #B4610F;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.cats {
  width: 196rpx;
  height: 100%;
  background: #EFF1F4;
}

.cat {
  padding: 32rpx 16rpx;
  font-size: 28rpx;
  color: #5C646E;
  text-align: center;
}

.cat-on {
  background: #FFFFFF;
  color: #E86A17;
  font-weight: 600;
}

.cats-tail {
  height: 240rpx;
}

.dishlist {
  flex: 1;
  height: 100%;
  padding: 20rpx 24rpx 0;
}

.dish {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.dish-off .dish-hit {
  opacity: 0.5;
}

.dish-hit {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #F5F6F8;
}

.cover-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E6;
  color: #E86A17;
  font-size: 46rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #23282F;
}

.dish-desc {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ---------- 标签筛选条 ---------- */

.tagbar {
  background: #FFFFFF;
  padding: 0 24rpx 16rpx;
}

.tagbar-scroll {
  white-space: nowrap;
  width: 100%;
}

.tagbar-row {
  display: inline-flex;
  align-items: center;
}

.tagpick {
  display: inline-block;
  font-size: 24rpx;
  color: #5A616B;
  background: #F2F3F6;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tagpick-on {
  color: #FFFFFF;
  background: #E86A17;
}

.tagpick-on .tagpick-count {
  color: #FFE3CE;
}

.tagpick-count {
  font-size: 20rpx;
  color: #9AA1A9;
  margin-left: 8rpx;
}

.dish-labels {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.label {
  font-size: 20rpx;
  color: #E86A17;
  background: #FFF1E6;
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
  margin: 0 8rpx 8rpx 0;
}

.dish-tags {
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #1D9E75;
  background: #E9F7F1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
}

.tag-stock {
  color: #2C6BB3;
  background: #EAF2FB;
}

.tag-off {
  color: #A32D2D;
  background: #FCEBEB;
}

.add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E86A17;
  color: #FFFFFF;
  font-size: 42rpx;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.add-off {
  background: #E4E6EA;
  color: #FFFFFF;
}

.list-tail {
  height: 180rpx;
}

.cartbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #23282F;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx 16rpx 36rpx;
}

.cartbar-left {
  display: flex;
  align-items: baseline;
}

.cartbar-count {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 600;
}

.cartbar-text {
  color: #B9BFC7;
  font-size: 26rpx;
  margin-left: 10rpx;
}

.cartbar-btn {
  background: #E86A17;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 20rpx 34rpx;
}
