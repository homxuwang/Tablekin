<view class="sort-page">
  <view class="sort-header">
    <view class="sort-title">{{title}} <text class="sort-count">{{items.length}} 项</text></view>
    <view class="sort-hint">长按左侧手柄拖动，或点置顶 / 置底。调整后点击保存。</view>
    <view wx:if="{{error}}" class="sort-error">{{error}} <text class="sort-reload" bindtap="refresh">重新加载</text></view>
  </view>
  <view wx:if="{{loading}}" class="sort-empty">正在加载…</view>
  <view wx:elif="{{!canManage || items.length === 0}}" class="sort-empty">{{canManage ? '还没有可排序的项目' : '暂时无法排序'}}</view>
  <scroll-view wx:else class="sort-scroll" scroll-y="{{true}}" scroll-top="{{scrollTop}}" scroll-with-animation="{{false}}" bindscroll="onScroll">
    <view class="sort-row {{dragging && dragId == item.id ? 'sort-placeholder' : ''}}" wx:for="{{items}}" wx:key="id">
      <view class="sort-handle" data-id="{{item.id}}" bindtouchstart="touchStart" bindlongpress="startDrag" catchtouchmove="touchMove" bindtouchend="endDrag" bindtouchcancel="cancelDrag">☰</view>
      <text class="sort-number">{{index + 1}}</text>
      <view class="sort-name">{{item.name}}</view>
      <button class="sort-action" disabled="{{index === 0 || saving || dragging}}" data-id="{{item.id}}" bindtap="toTop">置顶</button>
      <button class="sort-action" disabled="{{index === items.length - 1 || saving || dragging}}" data-id="{{item.id}}" bindtap="toBottom">置底</button>
    </view>
  </scroll-view>
  <view wx:if="{{dragging}}" class="sort-ghost" style="top: {{dragTop}}px; height: {{dragHeight}}px;">
    <text class="sort-handle">☰</text><view class="sort-name">{{dragName}}</view><text class="sort-ghost-hint">松手放置</text>
  </view>
  <view class="sort-footer">
    <view class="sort-status">{{dirty ? '有未保存的调整' : '当前顺序已同步'}} · 置顶为移到第一位</view>
    <view class="sort-buttons">
      <button class="sort-cancel" disabled="{{saving || dragging}}" bindtap="cancel">取消</button>
      <button class="sort-save" disabled="{{!canManage || !dirty || saving || dragging || loading}}" bindtap="save">{{saving ? '保存中…' : '保存顺序'}}</button>
    </view>
  </view>
</view>
