page {
  background: #F7F4EF;
  color: #1F1A17;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.card {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
}

.muted {
  color: #8F847B;
}

.btn-primary {
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
  padding: 28rpx 0;
  border-radius: 999rpx;
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(223, 94, 22, 0.28);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.btn-primary:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.btn-primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #DF5E16;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  padding: 26rpx 0;
  border: 2rpx solid #F3CDB0;
  border-radius: 999rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(42, 28, 16, 0.03);
  transition: transform 0.14s ease, background 0.14s ease;
}

.btn-ghost:active {
  transform: scale(0.985);
  background: #FFF6EE;
}

.btn-danger {
  background: #FFF9F9;
  color: #C93A3A;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  padding: 26rpx 0;
  border: 2rpx solid #F5C7C7;
  border-radius: 999rpx;
  text-align: center;
  transition: transform 0.14s ease, background 0.14s ease;
}

.btn-danger:active {
  transform: scale(0.985);
  background: #FCECEC;
}

.empty {
  padding: 140rpx 48rpx;
  text-align: center;
  color: #9E938A;
  font-size: 28rpx;
  line-height: 1.75;
}

.field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 25rpx;
  font-weight: 500;
  color: #8A7E74;
  margin-bottom: 14rpx;
}

.field-input {
  font-size: 30rpx;
  color: #1F1A17;
  width: 100%;
  min-height: 44rpx;
}

.field-textarea {
  font-size: 30rpx;
  color: #1F1A17;
  width: 100%;
  min-height: 160rpx;
  line-height: 1.65;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #7D7168;
  letter-spacing: 0.6rpx;
  padding: 36rpx 8rpx 16rpx;
}

.illus-empty {
  width: 240rpx;
  height: 240rpx;
  display: block;
  margin: 0 auto 20rpx;
  border-radius: 32rpx;
}

.illus-sm {
  width: 196rpx;
  height: 196rpx;
  display: block;
  margin: 0 auto 16rpx;
  border-radius: 28rpx;
}

.cover-wrap {
  position: relative;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-initial {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  border-radius: 10rpx;
  background: rgba(31, 26, 23, 0.56);
  backdrop-filter: blur(6px);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}
