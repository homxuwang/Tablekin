.page {
  padding-bottom: 160rpx;
}

.hero {
  background: linear-gradient(135deg, #E86A17 0%, #F2913F 100%);
  padding: 40rpx 30rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-top: 10rpx;
}

.hero-add {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF4EC;
  color: #C05510;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 待处理 */
.todo {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #FBE0CB;
}

.todo-head {
  font-size: 26rpx;
  color: #E86A17;
  font-weight: 600;
}

.todo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.todo-name {
  font-size: 28rpx;
  color: #23282F;
}

.todo-text {
  font-size: 24rpx;
  color: #B4610F;
}

.todo-go {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #E86A17;
  text-align: right;
}

.section-title {
  padding: 32rpx 32rpx 14rpx;
  font-size: 28rpx;
  color: #5C646E;
  font-weight: 600;
}

.hint {
  margin: 0 24rpx;
  padding: 44rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 26rpx;
  line-height: 1.7;
}

.hint-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B4B9C0;
}

.kcard {
  margin: 0 24rpx 20rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.kcard-head {
  display: flex;
  align-items: center;
}

.kcard-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #FDEEE2;
  color: #E86A17;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
  flex-shrink: 0;
}

.kcard-main {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.kcard-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.kcard-sub {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

.tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #E86A17;
  background: #FDEEE2;
  border-radius: 999rpx;
}

.kcard-tools {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.chip {
  flex: 1;
  margin-right: 12rpx;
  padding: 0;
  height: 62rpx;
  line-height: 58rpx;
  font-size: 24rpx;
  font-weight: 400;
  text-align: center;
  color: #6B727B;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EA;
  border-radius: 999rpx;
  overflow: hidden;
}

.chip:last-child {
  margin-right: 0;
}

.chip-main {
  color: #FFFFFF;
  background: #E86A17;
  border-color: #E86A17;
}

.chip-share {
  color: #E86A17;
  border-color: #F3C9A8;
}

.actions {
  padding: 12rpx 32rpx 0;
}

.actions .btn-ghost {
  margin-top: 20rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
}

.foot-hint {
  margin: 28rpx 24rpx 0;
  font-size: 23rpx;
  color: #A6ACB4;
  text-align: center;
}
