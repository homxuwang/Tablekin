.page {
  padding-bottom: 40rpx;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF4EC;
  color: #C05510;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  padding: 32rpx 32rpx 14rpx;
}

.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.hint {
  padding: 40rpx 28rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 26rpx;
}

.invite {
  padding: 30rpx;
}

.invite-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
}

.invite-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8A9099;
  line-height: 1.7;
}

.invite-btn {
  margin-top: 26rpx;
  width: 100%;
}

.invite-code {
  margin-top: 20rpx;
  text-align: center;
  font-size: 25rpx;
  color: #E86A17;
  letter-spacing: 1rpx;
}

.m-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.m-row:last-child {
  border-bottom: none;
}

.m-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #FDEEE2;
  color: #E86A17;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}

.m-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.m-name {
  font-size: 30rpx;
  color: #23282F;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.m-sub {
  font-size: 23rpx;
  color: #9AA1A9;
  margin-top: 8rpx;
}

.tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #6B727B;
  background: #EEF1F5;
  border-radius: 999rpx;
}

.tag-owner {
  color: #E86A17;
  background: #FDEEE2;
}

.tag-soft {
  margin-left: 8rpx;
}

.m-actions {
  flex-shrink: 0;
}

.m-act {
  font-size: 25rpx;
  color: #E86A17;
  padding: 8rpx 4rpx;
}

.m-act-danger {
  color: #D64545;
}

.actions {
  padding: 24rpx 32rpx 0;
}
