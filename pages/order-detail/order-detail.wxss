.page {
  padding-bottom: 72rpx;
}

.head {
  background: #FFFFFF;
  padding: 36rpx 34rpx 42rpx;
  border-radius: 0 0 38rpx 38rpx;
  box-shadow: 0 10rpx 28rpx rgba(42, 28, 16, 0.05);
}

.head-status {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.st-wait {
  color: #C2670E;
}

.st-ack {
  color: #2563EB;
}

.st-doing {
  color: #158059;
}

.st-done {
  color: #685E56;
}

.st-off {
  color: #C83737;
}

.head-hint {
  font-size: 26rpx;
  color: #8A7E74;
  margin-top: 12rpx;
  line-height: 1.6;
}

.head-sub {
  font-size: 26rpx;
  font-weight: 500;
  color: #C83737;
  margin-top: 10rpx;
}

.panel {
  margin: 24rpx 24rpx 0;
  padding: 10rpx 28rpx 18rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #7D7168;
  padding: 22rpx 0 16rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F4EFE8;
}

.row:last-child {
  border-bottom: none;
}

.row-block {
  display: block;
}

.row-k {
  font-size: 26rpx;
  color: #8F847B;
  flex-shrink: 0;
}

.row-v {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1A17;
  text-align: right;
  padding-left: 24rpx;
}

.row-note {
  font-size: 27rpx;
  color: #1F1A17;
  background: #FAF7F2;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.row-note-red {
  color: #C83737;
  background: #FEF0F0;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4EFE8;
}

.item:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1A17;
}

.item-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #DF5E16;
}

/* 进度时间轴（带垂直连接线与高亮光环） */
.step {
  display: flex;
  align-items: flex-start;
  padding-bottom: 34rpx;
  position: relative;
}

.step::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 28rpx;
  bottom: -6rpx;
  width: 3rpx;
  background: #EBE4DB;
}

.step-on::before {
  background: #F4C7A3;
}

.step:last-child {
  padding-bottom: 10rpx;
}

.step:last-child::before {
  display: none;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E2DBD2;
  margin: 8rpx 22rpx 0 0;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.step-on .dot {
  background: #DF5E16;
  box-shadow: 0 0 0 6rpx rgba(223, 94, 22, 0.16);
}

.step-main {
  flex: 1;
  min-width: 0;
}

.step-label {
  font-size: 28rpx;
  color: #B4AAA0;
}

.step-on .step-label {
  color: #1F1A17;
  font-weight: 600;
}

.step-time {
  font-size: 22rpx;
  color: #9E938A;
  margin-top: 6rpx;
}

.actions {
  padding: 36rpx 32rpx 0;
}

.actions > view {
  margin-bottom: 20rpx;
}

.actions > view:last-child {
  margin-bottom: 0;
}
