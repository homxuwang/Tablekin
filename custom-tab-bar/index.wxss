.bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  background: rgba(255, 253, 249, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(60, 42, 24, 0.08);
  border-radius: 999rpx;
  box-shadow: 0 14rpx 38rpx rgba(38, 24, 12, 0.12), 0 2rpx 8rpx rgba(38, 24, 12, 0.05);
  padding: 10rpx 12rpx;
}

.bar-content {
  display: flex;
  height: 98rpx;
}

.item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9E938A;
  border-radius: 999rpx;
  transition: background 0.18s ease, color 0.18s ease, transform 0.14s ease;
}

.item:active {
  transform: scale(0.95);
}

.item.on {
  color: #DF5E16;
  background: #FFF1E5;
}

.ic {
  position: relative;
  width: 44rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.ic .s1,
.ic .s2,
.ic .s3 {
  position: absolute;
  display: none;
  box-sizing: border-box;
}

/* 点菜：一只碗 */
.ic-eat .s1 {
  display: block;
  left: 5rpx;
  top: 14rpx;
  width: 34rpx;
  height: 18rpx;
  border: 3.5rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
}

.ic-eat .s2 {
  display: block;
  left: 2rpx;
  top: 11rpx;
  width: 40rpx;
  height: 3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
}

/* 下厨：一口锅 */
.ic-cook .s1 {
  display: block;
  left: 3rpx;
  top: 9rpx;
  width: 27rpx;
  height: 27rpx;
  border: 3.5rpx solid currentColor;
  border-radius: 50%;
}

.ic-cook .s2 {
  display: block;
  left: 28rpx;
  top: 17rpx;
  width: 14rpx;
  height: 3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
}

/* 订单：一张单子 */
.ic-order .s1 {
  display: block;
  left: 7rpx;
  top: 5rpx;
  width: 30rpx;
  height: 32rpx;
  border: 3.5rpx solid currentColor;
  border-radius: 7rpx;
}

.ic-order .s2 {
  display: block;
  left: 14rpx;
  top: 14rpx;
  width: 16rpx;
  height: 3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.ic-order .s3 {
  display: block;
  left: 14rpx;
  top: 23rpx;
  width: 12rpx;
  height: 3.5rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.label {
  font-size: 21rpx;
  font-weight: 500;
  margin-top: 6rpx;
  height: 26rpx;
  line-height: 26rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.item.on .label {
  font-weight: 600;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -24rpx;
  min-width: 28rpx;
  padding: 2rpx 8rpx;
  background: linear-gradient(135deg, #E5484D 0%, #C93035 100%);
  border: 3rpx solid #FFFDF9;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(214, 69, 69, 0.32);
}
