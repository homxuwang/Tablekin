<view class="page">
  <view class="top-head">
    <view class="top-main">
      <view class="top-title">食材仓库</view>
      <view class="top-sub">
        共 {{list.length}} 种食材<block wx:if="{{lowCount > 0}}"> · <text class="sub-warn">{{lowCount}} 种需补货</text></block>
      </view>
    </view>
    <view class="top-add" bindtap="openNew">+ 记食材</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{pendingStock}}" class="pending-card">
    <view class="pending-main">
      <view class="pending-title">上次库存操作待确认</view>
      <view class="pending-sub">{{pendingStock.ingredientName || '食材'}} · {{pendingStock.mode === 'delta' ? '入库' : '盘点'}} {{pendingStock.value}}</view>
    </view>
    <view class="pending-btn" bindtap="retryStock">{{stockBusy ? '确认中…' : '重试确认'}}</view>
  </view>

  <view wx:if="{{lowCount > 0 && filterMode !== 'low'}}" class="alert" bindtap="filterLow">
    <view class="alert-head">
      <view class="alert-title">有 {{lowCount}} 种食材该补货了</view>
      <view class="alert-go">只看缺货 ›</view>
    </view>
    <view class="alert-chips">
      <block wx:for="{{list}}" wx:key="id">
        <text wx:if="{{item.low}}" class="alert-chip">{{item.name}} · {{item.stockText}}{{item.unit}}</text>
      </block>
    </view>
  </view>

  <view wx:if="{{showForm}}" class="panel form-panel">
    <view class="panel-head" bindtap="toggleForm">
      <view class="panel-title">{{form.id ? '编辑食材' : '新增食材'}}</view>
      <view class="panel-action">收起</view>
    </view>
    <view class="field">
      <view class="field-label">名称</view>
      <input
        class="field-input"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        placeholder="例如：五花肉"
        maxlength="20"
        disabled="{{saving}}"
      />
    </view>
    <view class="field">
      <view class="field-label">单位</view>
      <input
        class="field-input"
        value="{{form.unit}}"
        data-field="unit"
        bindinput="onInput"
        placeholder="克 / 个 / 把 / 瓶"
        maxlength="6"
        disabled="{{saving}}"
      />
    </view>
    <view wx:if="{{!form.id}}" class="field">
      <view class="field-label">初始库存</view>
      <input
        class="field-input"
        type="digit"
        value="{{form.stock}}"
        data-field="stock"
        bindinput="onInput"
        placeholder="0"
        disabled="{{saving}}"
      />
    </view>
    <view class="field">
      <view class="field-label">低于这个数就提醒补货</view>
      <input
        class="field-input"
        type="digit"
        value="{{form.alert_threshold}}"
        data-field="alert_threshold"
        bindinput="onInput"
        placeholder="填 0 表示不提醒"
        disabled="{{saving}}"
      />
    </view>
    <view wx:if="{{form.id}}" class="field-note">要改库存请用列表里的「入库」或「盘点」，这样会留下记录。</view>
    <view class="form-actions">
      <view class="btn-primary {{saving ? 'disabled' : ''}}" bindtap="saveForm">{{saving ? '保存中…' : '保存食材'}}</view>
    </view>
  </view>

  <view wx:if="{{list.length > 0}}" class="toolbar">
    <view class="search-box">
      <icon type="search" size="14" color="#9E938A"></icon>
      <input
        class="search-input"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        placeholder="筛选食材名称…"
        maxlength="20"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>
    <view class="filter-pills">
      <view class="fpill {{filterMode === 'all' ? 'fpill-on' : ''}}" data-mode="all" bindtap="switchFilter">全部 {{list.length}}</view>
      <view class="fpill {{filterMode === 'low' ? 'fpill-on' : ''}}" data-mode="low" bindtap="switchFilter">需补货 {{lowCount}}</view>
    </view>
  </view>

  <view class="panel list-panel">
    <view wx:if="{{loading}}" class="hint">正在加载…</view>
    <view wx:elif="{{list.length === 0}}" class="hint">
      <image class="illus-sm" src="/assets/images/empty-kitchen.jpg" mode="aspectFit"></image>
      <view>还没有食材。点下方「新增食材」加一个「五花肉」，再挂到菜品上。</view>
    </view>
    <view wx:elif="{{filteredList.length === 0}}" class="hint">
      <view>没有找到符合条件的食材</view>
      <view class="hint-link" bindtap="clearSearch">清空筛选</view>
    </view>
    <view class="item" wx:for="{{filteredList}}" wx:key="id">
      <view class="item-head">
        <view class="item-name-wrap">
          <view class="item-name">{{item.name}}</view>
          <text class="status-pill {{item.outOfStock ? 'status-out' : item.low ? 'status-low' : 'status-ok'}}">{{item.statusText}}</text>
        </view>
        <view class="item-stock">
          <text class="stock-num {{item.low ? 'stock-low' : ''}}">{{item.stockText}}</text>
          <text class="stock-unit">{{item.unit}}</text>
        </view>
      </view>
      <view class="stock-track">
        <view class="stock-fill {{item.outOfStock ? 'fill-out' : item.low ? 'fill-low' : 'fill-ok'}}" style="width: {{item.fillPercent}}%;"></view>
      </view>
      <view wx:if="{{item.low}}" class="item-warn">低于预警线 {{item.alertText}}{{item.unit}}，记得采购</view>
      <view class="item-actions">
        <view class="act-primary-group">
          <view class="act-btn act-in" bindtap="stockIn" data-id="{{item.id}}">+ 入库</view>
          <view class="act-btn act-check" bindtap="recount" data-id="{{item.id}}">盘点</view>
        </view>
        <view class="act-secondary-group">
          <view class="act-link" bindtap="showLogs" data-id="{{item.id}}">明细</view>
          <view class="act-link" bindtap="openEdit" data-id="{{item.id}}">编辑</view>
          <view class="act-link act-danger" bindtap="removeItem" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{logsFor}}" class="sheet-mask" bindtap="closeLogs">
    <view class="sheet-card" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-title">{{logsName}} · 库存明细</view>
        <view class="sheet-close" bindtap="closeLogs">完成</view>
      </view>
      <scroll-view class="sheet-body" scroll-y>
        <view wx:if="{{logsLoading}}" class="hint">正在加载…</view>
        <view wx:elif="{{logs.length === 0}}" class="hint">还没有变动记录</view>
        <view class="log" wx:for="{{logs}}" wx:key="id">
          <view class="log-main">
            <view class="log-reason">{{item.reason}}</view>
            <view class="log-time">{{item.timeText}}</view>
          </view>
          <view class="log-right">
            <view class="log-change {{item.positive ? 'log-up' : 'log-down'}}">{{item.changeText}}</view>
            <view class="log-balance">{{item.balanceText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="dock">
    <view class="btn-primary dock-btn" bindtap="openNew">+ 新增食材</view>
  </view>
</view>
