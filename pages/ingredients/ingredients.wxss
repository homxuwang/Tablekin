.hero {
  padding: 26rpx 32rpx 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.06);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1A17;
}

.hero-sub {
  font-size: 25rpx;
  color: #8F847B;
  margin-top: 8rpx;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FEF0F0;
  border: 1rpx solid #F8CBCB;
  color: #C83737;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.alert {
  margin: 22rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF2E5 100%);
  border: 1.5rpx solid #F6CFAF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(223, 94, 22, 0.07);
}

.alert-title {
  font-size: 27rpx;
  color: #C2670E;
  font-weight: 700;
}

.alert-chips {
  margin-top: 14rpx;
}

.alert-chip {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: #C2670E;
  background: #FFFFFF;
  border: 1rpx solid #F5D5B8;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 8rpx 12rpx 0 0;
}

.panel {
  margin: 22rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  overflow: hidden;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.panel-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
}

.panel-action {
  font-size: 25rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.field-note {
  padding: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #8F847B;
  line-height: 1.6;
}

.form-actions {
  padding: 24rpx 30rpx 30rpx;
}

.hint {
  padding: 46rpx 30rpx;
  font-size: 26rpx;
  color: #9E938A;
  text-align: center;
  line-height: 1.7;
}

.item {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
  flex: 1;
  min-width: 0;
}

.item-stock {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.stock-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #158059;
}

.stock-low {
  color: #C93A3A;
}

.stock-unit {
  font-size: 24rpx;
  color: #8F847B;
  margin-left: 6rpx;
}

.item-warn {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #C2670E;
}

.item-tools {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tool {
  font-size: 25rpx;
  font-weight: 600;
  color: #5C534C;
  background: #FAF7F2;
  border: 1.5rpx solid #EAE2D9;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin: 0 12rpx 10rpx 0;
  transition: transform 0.14s ease;
}

.tool:first-child {
  color: #DF5E16;
  background: #FFF2E6;
  border-color: #F4CCB0;
}

.tool:active {
  transform: scale(0.94);
}

.tool-danger {
  color: #C93A3A;
  background: #FFF8F8;
  border-color: #F5C7C7;
}

.log {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.log:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-reason {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F1A17;
}

.log-time {
  font-size: 22rpx;
  color: #9E938A;
  margin-top: 6rpx;
}

.log-change {
  font-size: 30rpx;
  font-weight: 700;
  width: 140rpx;
  text-align: right;
}

.log-up {
  color: #158059;
}

.log-down {
  color: #C93A3A;
}

.log-balance {
  font-size: 24rpx;
  color: #8F847B;
  width: 160rpx;
  text-align: right;
}

.actions {
  padding: 36rpx 28rpx 64rpx;
}

.actions > view + view {
  margin-top: 20rpx;
}
