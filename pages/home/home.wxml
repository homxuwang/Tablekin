<view class="page">
  <view class="hero">
    <image class="hero-emblem" src="/assets/images/dish-placeholder.jpg" mode="aspectFill"></image>
    <view class="hero-text">
      <view class="hero-title">今天想吃点什么</view>
      <view class="hero-sub">
        {{mineCount > 0 ? '你也是大厨，自己的厨房在「下厨」里' : '挑一家厨房，点几道菜让 TA 做'}}
      </view>
    </view>
    <view class="hero-search" bindtap="goSearch">
      <icon type="search" size="17" color="#FFFFFF"></icon>
    </view>
  </view>

  <view class="quick-bar">
    <view class="quick-search" bindtap="goSearch">
      <icon type="search" size="15" color="#9E938A"></icon>
      <text class="quick-search-txt">搜菜名、标签或朋友的厨房…</text>
    </view>
    <view class="quick-join" bindtap="goJoin">输码加入</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{lastKitchen}}" class="resume" bindtap="openMenu" data-id="{{lastKitchen.id}}">
    <view class="resume-avatar">{{lastKitchen.initial}}</view>
    <view class="resume-main">
      <view class="resume-label">上次点菜的地方</view>
      <view class="resume-name">{{lastKitchen.name}}</view>
    </view>
    <view class="resume-go">继续点菜 ›</view>
  </view>

  <block wx:if="{{ongoing.length > 0}}">
    <view class="section-title">进行中的点单</view>
    <view class="ocard" wx:for="{{ongoing}}" wx:key="id" bindtap="openOrder" data-id="{{item.id}}">
      <view class="ocard-top">
        <view class="ocard-kitchen">{{item.kitchenName}}</view>
        <view class="status {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="ocard-line">{{item.dishesText || '菜品明细'}} · 共 {{item.total}} 份</view>
      <view class="ocard-line ocard-dim">想吃：{{item.mealTimeText}} · {{item.timeText}} 下单</view>
    </view>
  </block>

  <view class="section-title">今天开饭的厨房</view>

  <view wx:if="{{loading}}" class="hint">正在看看谁家开饭…</view>

  <block wx:elif="{{kitchens.length === 0}}">
    <view class="hint">
      <image class="illus-empty" src="/assets/images/empty-kitchen.jpg" mode="aspectFit"></image>
      <block wx:if="{{mineCount > 0}}">
        <view>还没有别人家的公开厨房</view>
        <view class="hint-sub">你的厨房在「下厨」里管着，随时能分享给家人</view>
      </block>
      <block wx:else>
        <view>还没有公开的厨房</view>
        <view class="hint-sub">你可以自己开一个，把菜单分享给家人朋友</view>
      </block>
    </view>
    <view wx:if="{{mineCount === 0}}" class="actions">
      <view class="btn-primary" bindtap="goChef">我也要开一个厨房</view>
    </view>
  </block>

  <block wx:else>
    <view
      class="kcard {{item.dishCount === 0 ? 'kcard-dim' : ''}}"
      wx:for="{{kitchens}}"
      wx:key="id"
      bindtap="openMenu"
      data-id="{{item.id}}"
    >
      <view class="kcard-avatar">{{item.initial}}</view>
      <view class="kcard-main">
        <view class="kcard-name">{{item.name}}</view>
        <view class="kcard-sub">{{item.description || '这个厨房还没有写简介'}}</view>
        <view class="kcard-tags">
          <text class="tag">{{item.dishText}}</text>
        </view>
      </view>
      <view class="kcard-go">{{item.dishCount > 0 ? '去点菜' : '看看'}}</view>
    </view>
    <view class="list-foot">
      想起谁家的菜？点右上角放大镜，按菜名或厨房名搜
    </view>
  </block>
</view>
