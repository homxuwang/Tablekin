.page {
  padding-bottom: 64rpx;
}

.top-head {
  padding: 20rpx 28rpx 0;
}

.top-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1A17;
  letter-spacing: -0.4rpx;
}

.top-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.invite-card {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 30rpx 26rpx;
  background: linear-gradient(135deg, #27201C 0%, #3A2E27 100%);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(31, 26, 23, 0.16);
}

.invite-kicker {
  font-size: 21rpx;
  font-weight: 700;
  color: #F49242;
  letter-spacing: 2rpx;
}

.invite-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.invite-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}

.invite-loading {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
}

.invite-err {
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #FFD1A9;
  font-size: 24rpx;
}

.invite-ticket {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1.5rpx dashed rgba(244, 146, 66, 0.55);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.ticket-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  flex-shrink: 0;
}

.ticket-code {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFF4E8;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-copy {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
}

.invite-share {
  margin-top: 22rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(223, 94, 22, 0.34);
}

.invite-share::after {
  border: none;
}

.invite-foot {
  margin-top: 18rpx;
  text-align: center;
}

.invite-reset {
  display: inline-block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.58);
  padding: 6rpx 16rpx;
}

.section-title {
  padding: 36rpx 32rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #7D7168;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  margin: 0 24rpx;
  overflow: hidden;
}

.hint {
  padding: 46rpx 28rpx;
  text-align: center;
  color: #9E938A;
  font-size: 26rpx;
}

.m-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.m-row:last-child {
  border-bottom: none;
}

.m-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.2);
}

.m-main {
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
}

.m-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F1A17;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.m-sub {
  font-size: 23rpx;
  color: #9E938A;
  margin-top: 8rpx;
}

.tag {
  margin-left: 10rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #685E56;
  background: #F4EFE8;
  border-radius: 999rpx;
}

.tag-owner {
  color: #DF5E16;
  background: #FFF1E5;
}

.tag-soft {
  margin-left: 8rpx;
  color: #2563EB;
  background: #EDF4FF;
}

.m-actions {
  flex-shrink: 0;
}

.m-act {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.m-act-danger {
  color: #C93A3A;
  background: #FEF0F0;
}

.actions {
  padding: 28rpx 32rpx 0;
}
