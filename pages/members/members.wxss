.page {
  padding-bottom: 64rpx;
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  padding: 36rpx 32rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #7D7168;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  margin: 0 24rpx;
  overflow: hidden;
}

.hint {
  padding: 46rpx 28rpx;
  text-align: center;
  color: #9E938A;
  font-size: 26rpx;
}

.invite {
  padding: 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF9F3 100%);
}

.invite-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.invite-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8A7E74;
  line-height: 1.7;
}

.invite-btn {
  margin-top: 28rpx;
  width: 100%;
}

.invite-code {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #DF5E16;
  background: #FFF1E5;
  border: 1.5rpx dashed #F2C49E;
  border-radius: 18rpx;
  letter-spacing: 2rpx;
}

.m-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.m-row:last-child {
  border-bottom: none;
}

.m-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.2);
}

.m-main {
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
}

.m-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F1A17;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.m-sub {
  font-size: 23rpx;
  color: #9E938A;
  margin-top: 8rpx;
}

.tag {
  margin-left: 10rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #685E56;
  background: #F4EFE8;
  border-radius: 999rpx;
}

.tag-owner {
  color: #DF5E16;
  background: #FFF1E5;
}

.tag-soft {
  margin-left: 8rpx;
  color: #2563EB;
  background: #EDF4FF;
}

.m-actions {
  flex-shrink: 0;
}

.m-act {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.m-act-danger {
  color: #C93A3A;
  background: #FEF0F0;
}

.actions {
  padding: 28rpx 32rpx 0;
}
