page {
  background: #F5F6F8;
  color: #23282F;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
}

.muted {
  color: #8A9099;
}

.btn-primary {
  background: #E86A17;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 1;
  padding: 26rpx 0;
  border-radius: 999rpx;
  text-align: center;
}

.btn-primary.disabled {
  opacity: 0.45;
}

.btn-ghost {
  background: #FFFFFF;
  color: #E86A17;
  font-size: 30rpx;
  line-height: 1;
  padding: 24rpx 0;
  border: 2rpx solid #F3C9A8;
  border-radius: 999rpx;
  text-align: center;
}

.btn-danger {
  background: #FFFFFF;
  color: #D64545;
  font-size: 30rpx;
  line-height: 1;
  padding: 24rpx 0;
  border: 2rpx solid #F2C4C4;
  border-radius: 999rpx;
  text-align: center;
}

.empty {
  padding: 140rpx 48rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 28rpx;
  line-height: 1.7;
}

.field {
  padding: 26rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #8A9099;
  margin-bottom: 12rpx;
}

.field-input {
  font-size: 30rpx;
  color: #23282F;
  width: 100%;
}

.field-textarea {
  font-size: 30rpx;
  color: #23282F;
  width: 100%;
  min-height: 160rpx;
  line-height: 1.6;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 26rpx;
  color: #8A9099;
  padding: 32rpx 8rpx 16rpx;
}
