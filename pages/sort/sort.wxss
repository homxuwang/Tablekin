.sort-page { height: 100vh; display: flex; flex-direction: column; background: #F5F6F8; }
.sort-header { flex-shrink: 0; padding: 32rpx 28rpx 24rpx; }
.sort-title { font-size: 36rpx; font-weight: 600; color: #23282F; }
.sort-count { font-size: 24rpx; font-weight: 400; color: #8A9099; margin-left: 12rpx; }
.sort-hint { font-size: 24rpx; line-height: 1.6; color: #8A9099; margin-top: 12rpx; }
.sort-error { margin-top: 16rpx; background: #FFF1E6; color: #A95016; padding: 16rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.6; }
.sort-reload { color: #E86A17; padding: 12rpx; text-decoration: underline; }
.sort-scroll { flex: 1; height: 0; min-height: 0; background: #FFFFFF; }
.sort-row { display: flex; align-items: center; height: 112rpx; box-sizing: border-box; padding-right: 16rpx; border-bottom: 1rpx solid #F1F2F4; }
.sort-handle { flex-shrink: 0; width: 84rpx; height: 100%; display: flex; align-items: center; justify-content: center; color: #9AA1A9; font-size: 32rpx; }
.sort-number { width: 48rpx; color: #9AA1A9; font-size: 22rpx; }
.sort-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; }
.sort-action { flex-shrink: 0; margin: 0 0 0 8rpx; padding: 0 16rpx; font-size: 24rpx; line-height: 64rpx; background: #FFF4EC; color: #C05510; border-radius: 12rpx; }
.sort-action[disabled] { color: #BCC0C7; background: #F7F8FA; }
.sort-placeholder { background: #FFF4EC; opacity: 0.3; }
.sort-ghost { position: fixed; left: 12rpx; right: 12rpx; z-index: 10; background: #FFF4EC; box-shadow: 0 6rpx 28rpx rgba(70,45,20,0.16); border: 2rpx solid #E86A17; border-radius: 14rpx; display: flex; align-items: center; pointer-events: none; box-sizing: border-box; }
.sort-ghost-hint { color: #C05510; font-size: 23rpx; padding: 0 20rpx; }
.sort-empty { flex: 1; text-align: center; color: #9AA1A9; padding: 60rpx 24rpx; }
.sort-footer { flex-shrink: 0; background: #FFFFFF; padding: 20rpx 28rpx 24rpx; padding-bottom: calc(24rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #EDEEF1; }
.sort-status { font-size: 23rpx; color: #8A9099; text-align: center; margin-bottom: 16rpx; }
.sort-buttons { display: flex; }
.sort-cancel, .sort-save { font-size: 28rpx; border-radius: 999rpx; margin: 0; line-height: 84rpx; }
.sort-cancel { width: 30%; color: #626B76; background: #F2F4F6; }
.sort-save { flex: 1; margin-left: 20rpx; background: #E86A17; color: #FFFFFF; }
.sort-save[disabled] { color: #FFFFFF; background: #EDB28C; }
