.page {
  padding-bottom: 200rpx;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  padding: 10rpx 24rpx 22rpx;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #7D7168;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #F4EFE8;
  transition: all 0.16s ease;
}

.tab + .tab {
  margin-left: 16rpx;
}

.tab-on {
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(223, 94, 22, 0.24);
}

.filters {
  display: flex;
  flex-wrap: wrap;
  padding: 14rpx 24rpx 6rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.05);
}

.filter {
  font-size: 23rpx;
  font-weight: 500;
  color: #685E56;
  background: #FAF7F2;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
}

.filter-on {
  color: #DF5E16;
  font-weight: 600;
  border-color: #F4CCB0;
  background: #FFF3E8;
}

.banner {
  margin: 18rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FEF0F0;
  border: 1rpx solid #F8CBCB;
  color: #C83737;
  border-radius: 18rpx;
  font-size: 25rpx;
}

/* 站内未读提醒 */
.notice-strip {
  margin: 22rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F4F9FF 100%);
  border: 1.5rpx solid #CFE1FA;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(37, 99, 235, 0.06);
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.notice-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1E54B7;
}

.notice-btn {
  font-size: 23rpx;
  font-weight: 600;
  color: #2563EB;
  background: #EAF2FF;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  text-align: center;
}

.notice-line {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E4EEF9;
}

.notice-what {
  font-size: 27rpx;
  font-weight: 600;
  color: #1F1A17;
}

.notice-body {
  font-size: 24rpx;
  color: #685E56;
  margin-top: 6rpx;
  line-height: 1.55;
}

.hint {
  margin: 24rpx;
  padding: 56rpx 32rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #8F847B;
  font-size: 27rpx;
  line-height: 1.75;
}

.hint-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ADA299;
}

.alert {
  margin: 22rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF2E6 100%);
  border-radius: 24rpx;
  border: 1.5rpx solid #F6CFAF;
  box-shadow: 0 8rpx 22rpx rgba(223, 94, 22, 0.07);
}

.alert-title {
  font-size: 27rpx;
  color: #C2670E;
  font-weight: 700;
}

.alert-line {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F7E1CE;
}

.alert-who {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F1A17;
}

.alert-why {
  font-size: 23rpx;
  color: #966640;
  margin-top: 6rpx;
}

.alert-btn {
  margin-top: 20rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: #DF5E16;
}

.order {
  margin: 22rpx 24rpx 0;
  padding: 26rpx 28rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.048);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-who {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.status {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
}

.st-wait {
  color: #C2670E;
  background: #FEF4E6;
}

.st-ack {
  color: #2563EB;
  background: #EDF4FF;
}

.st-doing {
  color: #158059;
  background: #EAF8F1;
}

.st-done {
  color: #685E56;
  background: #F2EFEA;
}

.st-off {
  color: #C83737;
  background: #FEEFEF;
}

.order-line {
  font-size: 25rpx;
  color: #7D7168;
  margin-top: 12rpx;
}

.order-items {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #FAF7F2;
  border-radius: 18rpx;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F1A17;
}

.dish-qty {
  font-size: 26rpx;
  font-weight: 700;
  color: #DF5E16;
}

.order-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #685E56;
  background: #FAF7F2;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

.order-note-red {
  color: #C83737;
  background: #FEF0F0;
}

.order-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F4EFE8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 23rpx;
  color: #9E938A;
}

.order-tools {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.tool {
  font-size: 24rpx;
  font-weight: 600;
  color: #685E56;
  background: #FAF7F2;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 999rpx;
  padding: 11rpx 26rpx;
  margin-left: 12rpx;
  transition: transform 0.14s ease;
}

.tool:active {
  transform: scale(0.94);
}

.tool-main {
  color: #FFFFFF;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.25);
}

.tool-soft {
  color: #2563EB;
  border-color: #C7DCFB;
  background: #F0F6FF;
}

.tool-danger {
  color: #C93A3A;
  background: #FFF8F8;
  border-color: #F5C7C7;
}

.list-foot {
  margin: 28rpx 24rpx 0;
  font-size: 23rpx;
  color: #ADA299;
  text-align: center;
}

.actions {
  padding: 16rpx 32rpx 0;
}

.status-filters {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx 4rpx;
}

.sfilter {
  font-size: 24rpx;
  font-weight: 500;
  color: #7D7168;
  background: #FFFFFF;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
}

.sfilter-on {
  color: #DF5E16;
  font-weight: 600;
  background: #FFF2E6;
  border-color: #F4CCB0;
}
