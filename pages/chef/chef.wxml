<view class="page">
  <view class="hero">
    <image class="hero-emblem" src="/assets/images/empty-kitchen.jpg" mode="aspectFill"></image>
    <view class="hero-text">
      <view class="hero-title">下厨</view>
      <view class="hero-sub">菜单、食材、家人都在这儿管</view>
    </view>
    <view class="hero-add" bindtap="newKitchen">＋ 新建</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{todos.length > 0}}" class="todo" bindtap="goOrders">
    <view class="todo-head">待你处理</view>
    <view class="todo-row" wx:for="{{todos}}" wx:key="id">
      <view class="todo-name">{{item.name}}</view>
      <view class="todo-text">{{item.text}}</view>
    </view>
    <view class="todo-go">去订单页回话 ›</view>
  </view>

  <view class="section-title">我的厨房</view>

  <view wx:if="{{loading}}" class="hint">正在加载…</view>

  <block wx:elif="{{kitchens.length === 0}}">
    <view class="hint">
      <image class="illus-empty" src="/assets/images/empty-kitchen.jpg" mode="aspectFit"></image>
      <view>你还没有自己的厨房</view>
      <view class="hint-sub">起个名字、写几道菜，就能让家人朋友来点单了</view>
    </view>
  </block>

  <view class="kcard" wx:for="{{kitchens}}" wx:key="id">
    <view class="kcard-head">
      <view class="kcard-avatar">{{item.initial}}</view>
      <view class="kcard-main">
        <view class="kcard-name">
          {{item.name}}
          <text class="tag">{{item.roleText}}</text>
        </view>
        <view class="kcard-sub">{{item.dishText}} · {{item.scopeText}}</view>
      </view>
    </view>
    <view class="kcard-tools">
      <view class="chip chip-main" bindtap="openMenu" data-id="{{item.id}}">点菜</view>
      <view class="chip" bindtap="openManage" data-id="{{item.id}}">管理</view>
      <view class="chip" bindtap="openMembers" data-id="{{item.id}}">邀请家人</view>
      <button class="chip chip-share" open-type="share" data-id="{{item.id}}">分享菜单</button>
    </view>
  </view>

  <view class="actions">
    <view class="btn-primary" bindtap="newKitchen">＋ 新建厨房</view>
    <view class="btn-ghost" bindtap="joinKitchen">用邀请码加入别人的厨房</view>
  </view>

  <view class="foot-hint">
    你也能当顾客：去「点菜」页看看别人家今天做什么
  </view>
</view>
