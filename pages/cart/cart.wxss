.page {
  min-height: 100vh;
  padding: 24rpx 0 220rpx;
  background: #F7F4EF;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F1A17;
  flex: 1;
  padding-right: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #FFF1E5;
  border: 1.5rpx solid #F5CEB0;
  color: #DF5E16;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 54rpx;
  text-align: center;
  transition: transform 0.12s ease;
}

.step:active {
  transform: scale(0.9);
  background: #FFE4CE;
}

.step-num {
  min-width: 68rpx;
  text-align: center;
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
}

.field-textarea.short {
  min-height: 96rpx;
}

.summary-card {
  background: #211B17;
  border-radius: 26rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 26, 23, 0.16);
}

.summary-title {
  color: #B9ADA3;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.summary-body {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.actions {
  padding: 8rpx 24rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost,
.actions .btn-danger {
  margin-bottom: 20rpx;
}

.warn-card {
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF2E5 100%);
  border: 1.5rpx solid #F6CFAF;
  border-radius: 26rpx;
  margin: 0 24rpx 24rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 8rpx 22rpx rgba(223, 94, 22, 0.08);
}

.warn-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #C2670E;
}

.warn-line {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F7E1CE;
}

.warn-ing {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1A17;
}

.warn-detail {
  font-size: 24rpx;
  color: #B45D0E;
  margin-top: 6rpx;
  line-height: 1.6;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #7D7168;
  padding: 28rpx 30rpx 8rpx;
}

/* 就餐时间 */
.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 30rpx 10rpx;
  font-size: 28rpx;
  color: #685E56;
}

.date-value {
  color: #DF5E16;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 30rpx 6rpx;
}

.chip {
  font-size: 26rpx;
  font-weight: 500;
  color: #685E56;
  background: #FAF7F2;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin: 0 14rpx 12rpx 0;
  transition: all 0.14s ease;
}

.chip-on {
  color: #FFFFFF;
  border-color: transparent;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.24);
}

.time-row {
  display: flex;
  align-items: center;
  padding: 14rpx 30rpx 0;
}

.time-box {
  background: #FAF7F2;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 16rpx;
  padding: 18rpx 34rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1F1A17;
}

.time-sep {
  font-size: 26rpx;
  color: #8F847B;
  padding: 0 18rpx;
}

.time-clear {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  margin-left: 20rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 30rpx 0;
}

.quick-chip {
  font-size: 24rpx;
  font-weight: 500;
  color: #685E56;
  background: #F5F1EB;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.quick-on {
  color: #DF5E16;
  font-weight: 600;
  background: #FFF0E3;
}

.time-hint {
  font-size: 24rpx;
  color: #9E938A;
  padding: 8rpx 30rpx 28rpx;
}

/* 底部发送条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 253, 249, 0.96);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(60, 42, 24, 0.08);
  box-shadow: 0 -8rpx 26rpx rgba(42, 28, 16, 0.06);
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bb-left {
  flex: 1;
  min-width: 0;
}

.bb-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.bb-sub {
  font-size: 23rpx;
  color: #8F847B;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bb-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 24rpx 48rpx;
  margin-left: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(223, 94, 22, 0.28);
  transition: transform 0.14s ease;
}

.bb-btn:active {
  transform: scale(0.96);
}

.bb-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.date-quick-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 16rpx 30rpx 0;
}

.date-picker-chip {
  color: #DF5E16;
  background: #FFF4EB;
  border: 1rpx solid #F4CCB0;
  font-weight: 600;
}

.note-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.warn-btn {
  margin-top: 22rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFFFFF;
  border: 1.5rpx solid #F4C59C;
  border-radius: 999rpx;
}
