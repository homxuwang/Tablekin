.page {
  padding-bottom: 64rpx;
}

.hero {
  padding: 28rpx 32rpx 16rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1A17;
  line-height: 1.35;
}

.hero-sub {
  font-size: 25rpx;
  color: #8A7E74;
  margin-top: 12rpx;
  line-height: 1.65;
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.048);
  margin: 24rpx;
  overflow: hidden;
}

.code {
  font-size: 38rpx;
  color: #DF5E16;
  letter-spacing: 8rpx;
  font-weight: 700;
}

.done {
  padding: 52rpx 32rpx;
  text-align: center;
}

.done-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F1A17;
}

.done-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8A7E74;
}

.actions {
  padding: 12rpx 32rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost {
  margin-bottom: 20rpx;
}
