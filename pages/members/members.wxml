<view class="page">
  <view class="top-head">
    <view class="top-title">成员与邀请</view>
    <view class="top-sub">共 {{members.length}} 位家人一起打理这个厨房</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{isOwner}}" class="invite-card">
    <view class="invite-kicker">共有人邀请</view>
    <view class="invite-title">邀请家人一起管厨房</view>
    <view class="invite-sub">
      点开分享卡片并填个称呼，就能一起管菜品、记库存、接单。
    </view>
    <view wx:if="{{inviteLoading}}" class="invite-loading">正在获取邀请码…</view>
    <view wx:if="{{inviteError}}" class="invite-err" bindtap="loadInvite">{{inviteError}} · 点击重试</view>
    <block wx:if="{{inviteCode}}">
      <view class="invite-ticket" bindtap="copyCode">
        <view class="ticket-label">专属邀请码</view>
        <view class="ticket-code">{{inviteCode}}</view>
        <view class="ticket-copy">复制</view>
      </view>
      <button class="invite-share" open-type="share" disabled="{{inviteLoading || inviteBusy}}">分享给微信好友</button>
      <view class="invite-foot">
        <view class="invite-reset" bindtap="resetInvite">
          {{inviteBusy ? '正在更换…' : '更换邀请码（旧链接将失效）'}}
        </view>
      </view>
    </block>
  </view>

  <view class="section-title">厨房成员（{{members.length}}）</view>
  <view class="panel">
    <view wx:if="{{loading}}" class="hint">正在加载…</view>
    <view class="m-row" wx:for="{{members}}" wx:key="id">
      <view class="m-avatar">{{item.initial}}</view>
      <view class="m-main">
        <view class="m-name">
          {{item.displayName}}
          <text class="tag {{item.isOwnerRow ? 'tag-owner' : ''}}">{{item.roleText}}</text>
          <text wx:if="{{item.isMe}}" class="tag tag-soft">我</text>
        </view>
        <view class="m-sub">加入于 {{item.joinedText}}</view>
      </view>
      <view class="m-actions">
        <view wx:if="{{item.isMe}}" class="m-act" bindtap="renameMe">改称呼</view>
        <view wx:elif="{{item.canRemove}}" class="m-act m-act-danger" bindtap="removeMember" data-id="{{item.id}}">移出</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!isOwner && myMemberId}}" class="actions">
    <view class="btn-danger" bindtap="leaveKitchen">退出这个厨房</view>
  </view>
</view>
