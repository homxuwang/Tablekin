<view class="page">
  <view wx:if="{{error}}" class="banner">{{error}}</view>
  <view wx:if="{{loading}}" class="hint">正在加载…</view>

  <block wx:else>
    <view class="section-title">{{editMode ? '厨房信息' : '开一个新厨房'}}</view>
    <view class="panel">
      <view class="field">
        <view class="field-label">厨房名称</view>
        <input
          class="field-input"
          value="{{form.name}}"
          data-field="name"
          bindinput="onInput"
          placeholder="比如「老王家的厨房」"
          maxlength="20"
          disabled="{{editMode && !isOwner}}"
        />
      </view>
      <view class="field">
        <view class="field-label">一句话简介</view>
        <textarea
          class="field-textarea"
          value="{{form.description}}"
          data-field="description"
          bindinput="onInput"
          placeholder="写点别人能看到的介绍，比如「家常菜为主，辣的不太做」"
          maxlength="80"
          disabled="{{editMode && !isOwner}}"
        ></textarea>
      </view>
      <view wx:if="{{!editMode}}" class="field">
        <view class="field-label">你在成员列表里的称呼</view>
        <input
          class="field-input"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          placeholder="比如「爸爸」，家人接单时能看到"
          maxlength="12"
        />
      </view>
      <view class="field row-between">
        <view class="field-main">
          <view class="field-label">公开这个厨房</view>
          <view class="field-hint">
            打开后别人能在首页搜到它并点菜；关掉后仅拥有者和共有人能访问
          </view>
        </view>
        <switch
          checked="{{form.is_public}}"
          bindchange="onPublicChange"
          color="#E86A17"
          disabled="{{editMode && !isOwner}}"
        />
      </view>
    </view>

    <view class="actions">
      <view wx:if="{{!editMode || isOwner}}" class="btn-primary {{saving ? 'disabled' : ''}}" bindtap="save">
        {{editMode ? '保存修改' : '创建厨房'}}
      </view>
      <view wx:if="{{editMode && isOwner}}" class="btn-danger" bindtap="removeKitchen">删除这个厨房</view>
      <view class="btn-ghost" bindtap="goBack">返回</view>
    </view>
  </block>
</view>
