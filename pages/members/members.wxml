<view class="page">
  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{isOwner}}" class="section-title">邀请共有人</view>
  <view wx:if="{{isOwner}}" class="panel invite">
    <view class="invite-title">把这个厨房的邀请发给家人</view>
    <view class="invite-sub">
      对方点开你分享的卡片并填个称呼，就成为共有人；能和你一样管菜品、管库存、接单。
    </view>
    <view wx:if="{{inviteLoading}}" class="invite-sub">正在获取邀请码…</view>
    <view wx:if="{{inviteError}}" class="banner" bindtap="loadInvite">{{inviteError}} · 点击重新获取</view>
    <button wx:if="{{inviteCode}}" class="btn-primary invite-btn" open-type="share" disabled="{{inviteLoading || inviteBusy}}">分享邀请链接给微信好友</button>
    <view wx:if="{{inviteCode}}" class="invite-code" bindtap="copyCode">
      邀请码 {{inviteCode}} · 点击复制
    </view>
    <view wx:if="{{inviteCode}}" class="invite-sub" style="margin-top:10rpx;text-decoration:underline" bindtap="resetInvite">
      {{inviteBusy ? '正在换码…' : '换一个邀请码（旧链接会失效）'}}
    </view>
  </view>

  <view class="section-title">成员（{{members.length}}）</view>
  <view class="panel">
    <view wx:if="{{loading}}" class="hint">正在加载…</view>
    <view class="m-row" wx:for="{{members}}" wx:key="id">
      <view class="m-avatar">{{item.initial}}</view>
      <view class="m-main">
        <view class="m-name">
          {{item.displayName}}
          <text class="tag {{item.isOwnerRow ? 'tag-owner' : ''}}">{{item.roleText}}</text>
          <text wx:if="{{item.isMe}}" class="tag tag-soft">我</text>
        </view>
        <view class="m-sub">加入于 {{item.joinedText}}</view>
      </view>
      <view class="m-actions">
        <view wx:if="{{item.isMe}}" class="m-act" bindtap="renameMe">改称呼</view>
        <view wx:elif="{{item.canRemove}}" class="m-act m-act-danger" bindtap="removeMember" data-id="{{item.id}}">移出</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!isOwner && myMemberId}}" class="actions">
    <view class="btn-danger" bindtap="leaveKitchen">退出这个厨房</view>
  </view>

  <view class="actions">
    <view class="btn-ghost" bindtap="goBack">返回</view>
  </view>
</view>
