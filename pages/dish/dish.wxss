.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #F5F6F8;
}

.hero {
  width: 100%;
  height: 460rpx;
  display: block;
  background: #EFE6DD;
}

.hero-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E6;
  color: #E86A17;
  font-size: 56rpx;
  font-weight: 600;
}

.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  overflow: hidden;
}

.dish-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #23282F;
  padding: 30rpx 30rpx 0;
}

.dish-sub {
  font-size: 26rpx;
  color: #8A9099;
  line-height: 1.6;
  padding: 14rpx 30rpx 0;
}

.chips {
  padding: 20rpx 30rpx 30rpx;
}

.chip {
  display: inline-block;
  font-size: 22rpx;
  color: #1D9E75;
  background: #E9F7F1;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.chip-dim {
  color: #8A9099;
  background: #F1F2F4;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #23282F;
  padding: 30rpx 30rpx 0;
}

.recipe {
  padding: 18rpx 30rpx 34rpx;
  font-size: 28rpx;
  color: #3C434C;
  line-height: 1.8;
  white-space: pre-wrap;
}

.recipe-locked {
  padding: 18rpx 30rpx 34rpx;
  font-size: 26rpx;
  color: #9AA1A9;
}

.actions {
  padding: 44rpx 24rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost,
.actions .btn-danger {
  margin-bottom: 20rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #23282F;
  padding: 6rpx 0;
}

.field-textarea.short {
  min-height: 96rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.image-card {
  width: 33.3333%;
  padding: 8rpx;
  box-sizing: border-box;
}

.image-preview {
  position: relative;
  height: 176rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F1F2F4;
}

.image-thumbnail {
  display: block;
  width: 100%;
  height: 100%;
}

.image-upload {
  height: 176rpx;
  border: 2rpx dashed #D8DBE0;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #E86A17;
}

.image-plus {
  font-size: 48rpx;
  line-height: 56rpx;
}

.image-cover {
  position: absolute;
  left: 0;
  top: 0;
  background: #E86A17;
  color: #FFFFFF;
  border-radius: 0 0 10rpx 0;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
}

.image-tools {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  line-height: 32rpx;
  padding: 14rpx 0;
}

.image-set-cover { color: #E86A17; }
.image-remove { color: #D64545; }
.image-disabled { opacity: 0.45; }
.image-hint { color: #8A9099; font-size: 24rpx; line-height: 1.6; margin-bottom: 14rpx; }
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #8A9099;
  font-size: 24rpx;
}
.image-unavailable { font-size: 28rpx; }

.switch-text {
  flex: 1;
  padding-right: 20rpx;
}

.switch-label {
  font-size: 30rpx;
  color: #23282F;
}

.switch-hint {
  font-size: 24rpx;
  color: #9AA1A9;
  margin-top: 8rpx;
  line-height: 1.5;
}

.panel-foot {
  padding: 12rpx 30rpx 0;
  font-size: 24rpx;
  color: #9AA1A9;
  line-height: 1.6;
}

.recipe-link {
  color: #E86A17;
  margin-left: 8rpx;
}

/* ---------- 标签 ---------- */

.chips-tags {
  padding-top: 0;
}

.chip-tag {
  color: #E86A17;
  background: #FFF1E6;
}

.tag-hint {
  color: #8A9099;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.tag-box {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: #E86A17;
  background: #FFF1E6;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag-x {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #D64545;
}

.tag-input {
  flex: 1;
  min-width: 220rpx;
  font-size: 28rpx;
  padding: 10rpx 0;
  margin-bottom: 12rpx;
}

.tag-suggest {
  margin-top: 6rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
}

.tag-pick {
  font-size: 24rpx;
  color: #5A616B;
  background: #F5F6F8;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag-count {
  font-size: 22rpx;
  color: #9AA1A9;
  margin-left: 8rpx;
}

.recipe-row {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.recipe-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #23282F;
}

.recipe-unit {
  font-size: 24rpx;
  color: #8A9099;
}

.recipe-amount {
  width: 180rpx;
  text-align: right;
  font-size: 30rpx;
  color: #23282F;
  padding: 8rpx 0;
}

.recipe-del {
  font-size: 26rpx;
  color: #D64545;
  margin-left: 24rpx;
}

.recipe-add {
  padding: 24rpx 30rpx 22rpx;
}

.recipe-add-btn {
  font-size: 28rpx;
  color: #E86A17;
  border: 2rpx dashed #F3C9A8;
  border-radius: 14rpx;
  padding: 20rpx 0;
  text-align: center;
}
