<view class="page">
  <view class="tabs">
    <view class="tabs-track">
      <view
        class="tab {{segment === 'mine' ? 'tab-on' : ''}}"
        bindtap="switchSegment"
        data-segment="mine"
      >我点的</view>
      <view
        class="tab {{segment === 'received' ? 'tab-on' : ''}}"
        bindtap="switchSegment"
        data-segment="received"
      >我收到的</view>
    </view>
  </view>

  <view wx:if="{{segment === 'received' && kitchens.length > 1}}" class="filters">
    <view
      class="filter {{filterKitchenId === 0 ? 'filter-on' : ''}}"
      bindtap="pickKitchen"
      data-id="0"
    >全部厨房</view>
    <view
      class="filter {{filterKitchenId === item.id ? 'filter-on' : ''}}"
      wx:for="{{kitchens}}"
      wx:key="id"
      bindtap="pickKitchen"
      data-id="{{item.id}}"
    >{{item.name}}</view>
  </view>

  <view class="status-filters">
    <view
      class="sfilter {{statusFilter === 'all' ? 'sfilter-on' : ''}}"
      bindtap="pickStatusFilter"
      data-status="all"
    >全部</view>
    <view
      class="sfilter {{statusFilter === 'active' ? 'sfilter-on' : ''}}"
      bindtap="pickStatusFilter"
      data-status="active"
    >进行中{{activeCount > 0 ? ' (' + activeCount + ')' : ''}}</view>
    <view
      class="sfilter {{statusFilter === 'done' ? 'sfilter-on' : ''}}"
      bindtap="pickStatusFilter"
      data-status="done"
    >已结束</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{noticesError}}" class="banner" bindtap="loadNotices">提醒加载失败：{{noticesError}} · 点击重试</view>
  <block wx:if="{{notices.length > 0 || unreadCount > 0}}">
    <view class="notice-strip">
      <view class="notice-head">
        <view class="notice-title">未读提醒（{{unreadCount}}）</view>
        <view class="notice-btn" bindtap="dismissNotices">{{noticesBusy ? '处理中…' : '全部已读'}}</view>
      </view>
      <view
        class="notice-line"
        wx:for="{{notices}}"
        wx:key="id"
        bindtap="openNotice"
        data-id="{{item.order_id}}"
        data-notice-id="{{item.id}}"
      >
        <view class="notice-what">{{item.title}}</view>
        <view wx:if="{{item.body}}" class="notice-body">{{item.body}}</view>
      </view>
      <view wx:if="{{unreadCount > notices.length}}" class="notice-btn" bindtap="moreNotices">查看更多提醒</view>
    </view>
  </block>

  <block wx:if="{{segment === 'received' && alerts.length > 0}}">
    <view class="alert">
      <view class="alert-title">有人想点，但食材不够（{{alerts.length}}）</view>
      <view class="alert-line" wx:for="{{alerts}}" wx:key="id">
        <view class="alert-who">{{item.diner_name}} 想点「{{item.dish_name}}」</view>
        <view class="alert-why">缺 {{item.ingredient_name}}：需要 {{item.needed}}，只剩 {{item.stock}}</view>
      </view>
      <view class="alert-btn" bindtap="dismissAlerts">知道了</view>
    </view>
  </block>

  <view wx:if="{{loading}}" class="hint">正在加载…</view>

  <block wx:elif="{{orders.length === 0}}">
    <view class="hint">
      <image class="illus-empty" src="/assets/images/empty-orders.jpg" mode="aspectFit"></image>
      <block wx:if="{{segment === 'received'}}">
        <view>还没有人点菜</view>
        <view class="hint-sub">把菜单分享给家人朋友，他们就能点了</view>
      </block>
      <block wx:else>
        <view>你还没有点过菜</view>
        <view class="hint-sub">去「点菜」页挑一家厨房吧</view>
      </block>
    </view>
    <view class="actions">
      <view wx:if="{{segment === 'mine'}}" class="btn-ghost" bindtap="goBrowse">去看看谁家开饭</view>
    </view>
  </block>

  <block wx:else>
    <view class="order" wx:for="{{orders}}" wx:key="id">
      <view class="order-head" bindtap="openDetail" data-id="{{item.id}}">
        <view class="order-who">
          <block wx:if="{{segment === 'received'}}">{{item.diner_name}} 点的</block>
          <block wx:else>{{item.kitchenName}}</block>
        </view>
        <view class="status {{item.statusClass}}">{{item.statusText}}</view>
      </view>

      <view class="order-line" bindtap="openDetail" data-id="{{item.id}}">
        想吃：{{item.mealTimeText}} · {{item.itemCount}} 道菜 共 {{item.total}} 份
      </view>

      <view class="order-items" bindtap="openDetail" data-id="{{item.id}}">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="id">
          <view class="dish-name">{{dish.dish_name}}</view>
          <view class="dish-qty">×{{dish.quantity}}</view>
        </view>
      </view>

      <view wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</view>
      <view wx:if="{{item.reject_reason}}" class="order-note order-note-red">回复：{{item.reject_reason}}</view>

      <view class="order-foot">
        <view class="order-time">{{item.dayText}} {{item.timeText}}</view>
        <view class="order-tools">
          <block wx:if="{{segment === 'received' && item.status === 'pending'}}">
            <view
              wx:if="{{!item.acked_at}}"
              class="tool tool-soft"
              bindtap="ack"
              data-id="{{item.id}}"
            >{{busyId === item.id ? '处理中…' : '收到'}}</view>
            <view class="tool tool-main" bindtap="accept" data-id="{{item.id}}">
              {{busyId === item.id ? '处理中…' : '接单'}}
            </view>
            <view class="tool" bindtap="reject" data-id="{{item.id}}">做不了</view>
          </block>
          <block wx:if="{{segment === 'received' && item.status === 'accepted'}}">
            <view class="tool tool-main" bindtap="finish" data-id="{{item.id}}">
              {{busyId === item.id ? '处理中…' : '已出餐'}}
            </view>
          </block>
          <block wx:if="{{segment === 'mine' && item.status === 'pending'}}">
            <view class="tool tool-danger" bindtap="cancel" data-id="{{item.id}}">撤销</view>
          </block>
        </view>
      </view>
    </view>
    <view class="list-foot">{{totalText}}</view>
  </block>
</view>
