.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F7F4EF;
}

.header {
  background: #FFFFFF;
  padding: 20rpx 30rpx 22rpx;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 6rpx 20rpx rgba(42, 28, 16, 0.03);
  position: relative;
  z-index: 4;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1A17;
  letter-spacing: -0.4rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #8F847B;
  margin-top: 8rpx;
}

/* 放大镜：在菜单页也能直接搜这个厨房的菜、或者搜别的厨房 */
.header-search {
  width: 74rpx;
  height: 74rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  border-radius: 50%;
  background: #FFF1E5;
  border: 1rpx solid #F8D4B7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.14s ease;
}

.header-search:active {
  transform: scale(0.92);
}

.header-tools {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.header-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF5EC;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  transition: transform 0.14s ease;
}

.header-btn:active {
  transform: scale(0.95);
}

.header-btn-soft {
  color: #685E56;
  background: #F7F4EF;
  border-color: #E7DFD6;
}

.banner {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FEF0F0;
  border: 1rpx solid #F8CBCB;
  color: #C83737;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.banner-go {
  margin-top: 14rpx;
  color: #DF5E16;
  font-size: 26rpx;
  font-weight: 600;
}

.notice {
  margin: 16rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #FEF5E7;
  border: 1rpx solid #F7D9B4;
  color: #B45D0E;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.cats {
  width: 192rpx;
  height: 100%;
  background: #EFEAE2;
}

.cat {
  position: relative;
  padding: 32rpx 18rpx;
  font-size: 26rpx;
  color: #6E645C;
  text-align: center;
  line-height: 1.4;
  transition: background 0.15s ease, color 0.15s ease;
}

.cat-on {
  background: #F7F4EF;
  color: #DF5E16;
  font-weight: 700;
}

.cat-on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26%;
  bottom: 26%;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: linear-gradient(180deg, #E2621A 0%, #F28637 100%);
}

.cats-tail {
  height: 240rpx;
}

.dishlist {
  flex: 1;
  height: 100%;
  padding: 20rpx 20rpx 0;
}

.dish {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.055);
  box-shadow: 0 6rpx 22rpx rgba(42, 28, 16, 0.045);
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.dish-off .dish-hit {
  opacity: 0.52;
}

.dish-hit {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #F4EFE8;
  box-shadow: 0 4rpx 14rpx rgba(42, 28, 16, 0.07);
}

.cover-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF3E6 0%, #FCE1C8 100%);
  color: #DF5E16;
  font-size: 48rpx;
  font-weight: 700;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.dish-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  line-height: 1.35;
}

.dish-desc {
  font-size: 23rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 标签筛选条 ---------- */

.tagbar {
  background: #FFFFFF;
  padding: 14rpx 24rpx 18rpx;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.05);
}

.tagbar-scroll {
  white-space: nowrap;
  width: 100%;
}

.tagbar-row {
  display: inline-flex;
  align-items: center;
}

.tagpick {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 500;
  color: #685E56;
  background: #F5F1EB;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all 0.14s ease;
}

.tagpick-on {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.24);
}

.tagpick-on .tagpick-count {
  color: #FFE4CE;
}

.tagpick-count {
  font-size: 20rpx;
  color: #9E938A;
  margin-left: 8rpx;
}

.dish-labels {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.label {
  font-size: 20rpx;
  font-weight: 500;
  color: #DF5E16;
  background: #FFF2E6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 0 8rpx 8rpx 0;
}

.dish-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 21rpx;
  font-weight: 600;
  color: #158059;
  background: #EAF8F1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 0 8rpx 6rpx 0;
}

.tag-stock {
  color: #2563EB;
  background: #EDF4FF;
}

.tag-off {
  color: #C83737;
  background: #FEEFEF;
}

.add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E2621A 0%, #F28536 100%);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 60rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.28);
  transition: transform 0.12s ease;
}

.add:active {
  transform: scale(0.88);
}

.add-off {
  background: #E7E2DB;
  color: #A2978E;
  box-shadow: none;
}

.list-tail {
  height: 200rpx;
}

.cartbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(31, 26, 23, 0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 14rpx 14rpx 34rpx;
  box-shadow: 0 18rpx 42rpx rgba(25, 16, 10, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  z-index: 30;
}

.cartbar-left {
  display: flex;
  align-items: center;
}

.cartbar-count {
  color: #FFFFFF;
  background: #DF5E16;
  font-size: 30rpx;
  font-weight: 700;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 14rpx;
}

.cartbar-text {
  color: #EAE4DC;
  font-size: 27rpx;
  font-weight: 500;
  margin-left: 16rpx;
}

.cartbar-btn {
  background: linear-gradient(135deg, #E2621A 0%, #F28536 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(223, 94, 22, 0.34);
  transition: transform 0.14s ease;
}

.cartbar-btn:active {
  transform: scale(0.95);
}

.header-btn-fun {
  color: #FFFFFF;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.24);
}

.cat-badge {
  position: absolute;
  top: 14rpx;
  right: 10rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #DF5E16;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  text-align: center;
}

.dish-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ds-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
  transition: transform 0.12s ease;
}

.ds-btn:active {
  transform: scale(0.88);
}

.ds-minus {
  background: #FFF2E6;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
}

.ds-plus {
  background: linear-gradient(135deg, #E2621A 0%, #F28536 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx rgba(223, 94, 22, 0.24);
}

.ds-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1A17;
}

.add-pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.add-pill-off {
  background: #EFEAE2;
  color: #9E938A;
}

.add-pill-warn {
  background: #FEF3E2;
  color: #C2670E;
  border: 1rpx solid #F6CFAF;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 26, 23, 0.42);
  z-index: 25;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: #FFFFFF;
  border-radius: 34rpx 34rpx 0 0;
  padding: 28rpx 30rpx calc(156rpx + env(safe-area-inset-bottom));
  max-height: 62vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -12rpx 36rpx rgba(25, 16, 10, 0.16);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F1A17;
}

.sheet-clear {
  font-size: 25rpx;
  font-weight: 500;
  color: #9E938A;
  padding: 6rpx 12rpx;
}

.sheet-list {
  max-height: 44vh;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F6F1EA;
}

.sheet-row:last-child {
  border-bottom: none;
}

.sheet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1A17;
  flex: 1;
  padding-right: 20rpx;
}
