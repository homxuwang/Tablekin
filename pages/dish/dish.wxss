.page {
  min-height: 100vh;
  padding-bottom: 72rpx;
  background: #F7F4EF;
}

.hero {
  width: 100%;
  height: 500rpx;
  display: block;
  background: #EFE7DC;
}

.hero-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 55%),
    linear-gradient(135deg, #FFF1E3 0%, #FAD6B4 100%);
  color: #D95712;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 0 40rpx;
  text-align: center;
}

.panel {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 10rpx 30rpx rgba(42, 28, 16, 0.055);
  margin: 24rpx 24rpx 0;
  overflow: hidden;
}

.hero + .panel {
  margin-top: -36rpx;
  position: relative;
  z-index: 2;
}

.dish-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1F1A17;
  padding: 34rpx 32rpx 0;
}

.dish-sub {
  font-size: 27rpx;
  color: #7D7168;
  line-height: 1.65;
  padding: 14rpx 32rpx 0;
}

.chips {
  padding: 22rpx 32rpx 30rpx;
}

.chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #158059;
  background: #EAF8F1;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}

.chip-dim {
  color: #8A7E74;
  background: #F4EFE8;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1A17;
  padding: 32rpx 32rpx 0;
}

.recipe {
  padding: 20rpx 32rpx 36rpx;
  font-size: 29rpx;
  color: #3A322C;
  line-height: 1.85;
  white-space: pre-wrap;
}

.recipe-locked {
  padding: 20rpx 32rpx 36rpx;
  font-size: 26rpx;
  color: #9E938A;
}

.actions {
  padding: 40rpx 28rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost,
.actions .btn-danger {
  margin-bottom: 20rpx;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F1A17;
  padding: 8rpx 0;
}

.field-textarea.short {
  min-height: 96rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.image-card {
  width: 33.3333%;
  padding: 8rpx;
  box-sizing: border-box;
}

.image-preview {
  position: relative;
  height: 184rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #F4EFE8;
}

.image-thumbnail {
  display: block;
  width: 100%;
  height: 100%;
}

.image-upload {
  height: 184rpx;
  border: 2rpx dashed #E6C7AE;
  background: #FFF9F4;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: #DF5E16;
}

.image-plus {
  font-size: 48rpx;
  line-height: 54rpx;
}

.image-cover {
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  border-radius: 0 0 14rpx 0;
  padding: 6rpx 14rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.image-tools {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  padding: 14rpx 4rpx;
}

.image-set-cover { color: #DF5E16; }
.image-remove { color: #C93A3A; }
.image-disabled { opacity: 0.45; }
.image-hint { color: #9E938A; font-size: 24rpx; line-height: 1.6; margin-bottom: 14rpx; }
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #9E938A;
  font-size: 24rpx;
}
.image-unavailable { font-size: 28rpx; }

.switch-text {
  flex: 1;
  padding-right: 20rpx;
}

.switch-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1A17;
}

.switch-hint {
  font-size: 24rpx;
  color: #9E938A;
  margin-top: 8rpx;
  line-height: 1.5;
}

.panel-foot {
  padding: 14rpx 32rpx 26rpx;
  font-size: 24rpx;
  color: #9E938A;
  line-height: 1.6;
}

.recipe-link {
  color: #DF5E16;
  font-weight: 600;
  margin-left: 8rpx;
}

/* ---------- 标签 ---------- */

.chips-tags {
  padding-top: 0;
}

.chip-tag {
  color: #DF5E16;
  background: #FFF1E5;
}

.tag-hint {
  color: #9E938A;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.tag-box {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag-x {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #C93A3A;
}

.tag-input {
  flex: 1;
  min-width: 220rpx;
  font-size: 28rpx;
  padding: 10rpx 0;
  margin-bottom: 12rpx;
}

.tag-suggest {
  margin-top: 8rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
}

.tag-pick {
  font-size: 24rpx;
  color: #685E56;
  background: #F5F1EB;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag-count {
  font-size: 21rpx;
  color: #9E938A;
  margin-left: 8rpx;
}

.recipe-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.recipe-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F1A17;
}

.recipe-unit {
  font-size: 24rpx;
  color: #8F847B;
}

.recipe-amount {
  width: 180rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1A17;
  background: #FAF7F2;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.recipe-del {
  font-size: 25rpx;
  font-weight: 500;
  color: #C93A3A;
  margin-left: 22rpx;
}

.recipe-add {
  padding: 24rpx 32rpx 14rpx;
}

.recipe-add-btn {
  font-size: 28rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF8F2;
  border: 2rpx dashed #F0C6A4;
  border-radius: 18rpx;
  padding: 22rpx 0;
  text-align: center;
}

.actions-view {
  padding-bottom: 160rpx;
}

.dish-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 253, 249, 0.96);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(60, 42, 24, 0.08);
  box-shadow: 0 -8rpx 26rpx rgba(42, 28, 16, 0.06);
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
}

.dish-bar-left {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #FFF2E6;
  border-radius: 999rpx;
}

.dish-bar-muted {
  background: #F4EFE8;
}

.dish-bar-badge {
  min-width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #DF5E16;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  margin-right: 10rpx;
}

.dish-bar-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F1A17;
}

.dish-bar-btn {
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(223, 94, 22, 0.26);
}

.dish-bar-off {
  background: #E7E2DB;
  color: #9E938A;
  box-shadow: none;
}

.dish-bar-stepper {
  display: flex;
  align-items: center;
}

.db-step {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 56rpx;
  text-align: center;
}

.db-minus {
  background: #FFF2E6;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
}

.db-plus {
  background: linear-gradient(135deg, #E2621A 0%, #F28536 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.24);
}

.db-num {
  min-width: 96rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 700;
  color: #1F1A17;
}
