<view class="page">
  <view class="top-head">
    <view class="top-main">
      <view class="top-title">今天想吃点什么</view>
      <view class="top-sub">
        {{mineCount > 0 ? '挑一家朋友厨房点单，或去「下厨」管自己的菜单' : '挑一家喜欢的厨房，点几道菜让 TA 做'}}
      </view>
    </view>
    <view class="top-join" bindtap="goJoin">输码加入</view>
  </view>

  <view class="search-wrap">
    <view class="search-pill" bindtap="goSearch">
      <icon type="search" size="16" color="#9E938A"></icon>
      <text class="search-placeholder">搜菜名、标签或朋友的厨房…</text>
      <view class="search-tag">搜一搜</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{lastKitchen}}" class="resume-hero" bindtap="openMenu" data-id="{{lastKitchen.id}}">
    <view class="resume-body">
      <view class="resume-kicker">上次常去</view>
      <view class="resume-title">{{lastKitchen.name}}</view>
      <view class="resume-cta">继续点菜 ›</view>
    </view>
    <image class="resume-art" src="/assets/images/dish-placeholder.jpg" mode="aspectFill"></image>
  </view>

  <block wx:if="{{ongoing.length > 0}}">
    <view class="sec-head">
      <view class="sec-title">进行中的点单</view>
      <view class="sec-count">{{ongoing.length}} 单</view>
    </view>
    <scroll-view class="ongoing-scroll" scroll-x>
      <view class="ongoing-row">
        <view
          class="ocard {{ongoing.length === 1 ? 'ocard-full' : ''}}"
          wx:for="{{ongoing}}"
          wx:key="id"
          bindtap="openOrder"
          data-id="{{item.id}}"
        >
          <view class="ocard-top">
            <view class="ocard-kitchen">{{item.kitchenName}}</view>
            <view class="status {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="ocard-line">{{item.dishesText || '菜品明细'}} · 共 {{item.total}} 份</view>
          <view class="ocard-bars">
            <view class="obar {{item.progressLevel >= 1 ? 'obar-on' : ''}}"></view>
            <view class="obar {{item.progressLevel >= 2 ? 'obar-on' : ''}}"></view>
            <view class="obar {{item.progressLevel >= 3 ? 'obar-on' : ''}}"></view>
            <view class="obar"></view>
          </view>
          <view class="ocard-foot">
            <text>想吃：{{item.mealTimeText}}</text>
            <text>{{item.timeText}} 下单 ›</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="sec-head">
    <view class="sec-title">今天开饭的厨房</view>
    <view wx:if="{{kitchens.length > 0}}" class="sec-count">{{kitchens.length}} 家</view>
  </view>

  <view wx:if="{{loading}}" class="hint">正在看看谁家开饭…</view>

  <block wx:elif="{{kitchens.length === 0}}">
    <view class="hint">
      <image class="illus-empty" src="/assets/images/empty-kitchen.jpg" mode="aspectFit"></image>
      <block wx:if="{{mineCount > 0}}">
        <view>还没有别人家的公开厨房</view>
        <view class="hint-sub">你的厨房在「下厨」里管着，随时能分享给家人</view>
      </block>
      <block wx:else>
        <view>还没有公开的厨房</view>
        <view class="hint-sub">你可以自己开一个，把菜单分享给家人朋友</view>
      </block>
    </view>
    <view wx:if="{{mineCount === 0}}" class="actions">
      <view class="btn-primary" bindtap="goChef">我也要开一个厨房</view>
    </view>
  </block>

  <block wx:else>
    <view class="kgrid">
      <view
        class="kcard {{item.dishCount === 0 ? 'kcard-dim' : ''}}"
        wx:for="{{kitchens}}"
        wx:key="id"
        bindtap="openMenu"
        data-id="{{item.id}}"
      >
        <view class="kcard-top">
          <view class="kcard-avatar">{{item.initial}}</view>
          <view class="kcard-pill {{item.dishCount === 0 ? 'kcard-pill-dim' : ''}}">{{item.dishText}}</view>
        </view>
        <view class="kcard-name">{{item.name}}</view>
        <view class="kcard-sub">{{item.description || '大厨还没写简介，进去看看菜单吧'}}</view>
        <view class="kcard-foot">
          <text class="kcard-go">{{item.dishCount > 0 ? '进厨房点菜' : '进去看看'}}</text>
          <text class="kcard-arrow">›</text>
        </view>
      </view>
    </view>
    <view class="list-foot">
      想起谁家的菜？点上方搜索框，按菜名或标签直达
    </view>
  </block>
</view>
