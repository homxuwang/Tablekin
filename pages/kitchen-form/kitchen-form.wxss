.page {
  padding-bottom: 40rpx;
}

.banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF4EC;
  color: #C05510;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  padding: 32rpx 32rpx 14rpx;
}

.hint {
  margin: 24rpx;
  padding: 40rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 26rpx;
}

.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.field-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-hint {
  font-size: 23rpx;
  color: #9AA1A9;
  line-height: 1.6;
}

.panel switch {
  transform: scale(0.85);
}

.actions {
  padding: 40rpx 32rpx 0;
}

.actions .btn-primary,
.actions .btn-danger,
.actions .btn-ghost {
  margin-bottom: 20rpx;
}
