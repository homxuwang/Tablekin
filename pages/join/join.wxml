<view class="page">
  <view class="hero">
    <view class="hero-title">有人邀请你一起管厨房</view>
    <view class="hero-sub">
      加入后就成为共有人，能一起维护菜单、食材库存，也能接家人的点单。
    </view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{!joined}}" class="panel">
    <view class="field">
      <view class="field-label">你的称呼</view>
      <input
        class="field-input"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        placeholder="家人会在成员列表和订单里看到这个名字，比如「妈妈」"
        maxlength="12"
      />
    </view>
    <view wx:if="{{code}}" class="field">
      <view class="field-label">邀请码</view>
      <view class="code">{{code}}</view>
    </view>
    <view wx:else class="field">
      <view class="field-label">邀请码</view>
      <input
        class="field-input"
        value="{{codeInput}}"
        bindinput="onCodeInput"
        placeholder="把邀请你的人给的邀请码填在这里"
        maxlength="40"
      />
    </view>
  </view>

  <view wx:else class="panel done">
    <view class="done-title">已加入「{{kitchenName}}」</view>
    <view class="done-sub">你现在是这个厨房的共有人了。</view>
  </view>

  <view class="actions">
    <block wx:if="{{joined}}">
      <view class="btn-primary" bindtap="goManage">进入厨房管理</view>
      <view class="btn-ghost" bindtap="goKitchen">看看菜单</view>
    </block>
    <block wx:else>
      <view class="btn-primary {{joining || !hasCode ? 'disabled' : ''}}" bindtap="join">
        {{joining ? '正在加入…' : '接受邀请，成为共有人'}}
      </view>
      <view class="btn-ghost" bindtap="goChef">去「下厨」看看我的厨房</view>
    </block>
  </view>
</view>
