.page {
  padding-bottom: 64rpx;
}

.top-head {
  padding: 20rpx 28rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.top-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.top-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1A17;
  letter-spacing: -0.4rpx;
}

.top-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
}

.top-preview {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFF1E5;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.kpi-grid {
  display: flex;
  padding: 24rpx 24rpx 0;
}

.kpi-card {
  flex: 1;
  padding: 26rpx 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(42, 28, 16, 0.045);
  text-align: center;
  margin-right: 16rpx;
  transition: transform 0.14s ease;
}

.kpi-card:last-child {
  margin-right: 0;
}

.kpi-card:active {
  transform: scale(0.96);
}

.kpi-hot {
  background: linear-gradient(135deg, #27201C 0%, #3A2E27 100%);
  border-color: transparent;
}

.kpi-hot .kpi-num {
  color: #F49242;
}

.kpi-hot .kpi-label {
  color: rgba(255, 255, 255, 0.82);
}

.kpi-warn {
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF1E3 100%);
  border-color: #F6CFAF;
}

.kpi-warn .kpi-num {
  color: #C2670E;
}

.kpi-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1A17;
  line-height: 1.1;
}

.kpi-label {
  font-size: 23rpx;
  font-weight: 500;
  color: #8A7E74;
  margin-top: 10rpx;
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  padding: 36rpx 32rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #7D7168;
}

.section-sort {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sort-entry {
  color: #DF5E16;
  font-size: 24rpx;
  font-weight: 600;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  margin: 0 24rpx;
  overflow: hidden;
}

.hint {
  padding: 46rpx 28rpx;
  text-align: center;
  color: #9E938A;
  font-size: 26rpx;
}

.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.cell:last-child {
  border-bottom: none;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F1A17;
}

.cell-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
}

.cell-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.alert {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF2E5 100%);
  border: 1.5rpx solid #F6CFAF;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.6;
}

.cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.cat-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F1A17;
}

.cat-tools {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.cat-tools switch {
  transform: scale(0.78);
}

.cat-del {
  font-size: 25rpx;
  font-weight: 500;
  color: #C93A3A;
  padding-left: 16rpx;
}

.add-cat {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx 10rpx;
}

.add-cat-input {
  flex: 1;
  height: 78rpx;
  background: #FAF7F2;
  border: 1.5rpx solid #EAE2D9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1F1A17;
}

.add-cat-btn {
  margin-left: 14rpx;
  padding: 0 32rpx;
  height: 78rpx;
  line-height: 78rpx;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.22);
}

.panel-foot {
  padding: 12rpx 30rpx 26rpx;
  font-size: 23rpx;
  color: #9E938A;
  line-height: 1.6;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F2ECE4;
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-row-main {
  flex: 1;
  min-width: 0;
}

.dish-row-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F1A17;
}

.dish-row-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.mini-tag {
  font-size: 21rpx;
  font-weight: 500;
  color: #7D7168;
  background: #F4EFE8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.mini-tag-off {
  color: #C83737;
  background: #FEF0F0;
}

.dish-row-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.actions {
  padding: 28rpx 32rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost {
  margin-bottom: 20rpx;
}

/* 固定可见高度，名称占据独立一行，避免按钮挤掉名称。 */
.inline-sort-scroll { display: block; height: 520rpx; background: #FFFFFF; }
.inline-sort-help { padding: 20rpx 26rpx; color: #8F847B; font-size: 24rpx; line-height: 1.6; background: #FAF7F2; }
.inline-sort-row { display: flex; align-items: center; height: 144rpx; box-sizing: border-box; padding-right: 24rpx; border-bottom: 1rpx solid #F2ECE4; }
.inline-sort-handle { width: 76rpx; height: 100%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #B4AAA0; }
.inline-sort-main { flex: 1; min-width: 0; }
.inline-sort-name { display: block; width: 100%; color: #1F1A17; font-size: 29rpx; font-weight: 600; line-height: 42rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.inline-sort-tools { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 8rpx; }
.inline-sort-index { flex: 1 0 64rpx; min-width: 64rpx; white-space: nowrap; font-size: 22rpx; line-height: 52rpx; color: #9E938A; }
.inline-sort-action { display: inline-flex; align-items: center; justify-content: center; width: 104rpx; min-width: 104rpx; max-width: 104rpx; flex: 0 0 104rpx; box-sizing: border-box; margin: 0 0 0 12rpx; padding: 0; white-space: nowrap; color: #C25A14; background: #FFF2E6; font-size: 23rpx; font-weight: 600; height: 52rpx; line-height: 52rpx; border-radius: 12rpx; }
.inline-sort-action[disabled] { color: #C8BFB6; background: #F5F1EB; }
.inline-sort-placeholder { opacity: 0.3; background: #FFF3E8; }
.inline-sort-ghost { position: fixed; left: 24rpx; right: 24rpx; z-index: 100; display: flex; align-items: center; background: #FFF5EC; border: 2rpx solid #DF5E16; border-radius: 18rpx; box-shadow: 0 10rpx 28rpx rgba(70,45,20,0.16); pointer-events: none; padding-right: 24rpx; }
.inline-sort-ghost .inline-sort-name { flex: 1; min-width: 0; }
.inline-sort-error { padding: 16rpx 24rpx; background: #FFF3E8; color: #A95016; font-size: 24rpx; line-height: 1.6; }
.inline-sort-error text { color: #DF5E16; padding-left: 12rpx; text-decoration: underline; }
.inline-sort-footer { display: flex; flex-direction: column; align-items: stretch; padding: 20rpx 24rpx; border-top: 1rpx solid #F2ECE4; background: #FAF7F2; }
.inline-sort-status { display: block; width: 100%; white-space: nowrap; line-height: 32rpx; margin-bottom: 12rpx; font-size: 22rpx; color: #8F847B; }
.inline-sort-buttons { display: flex; flex-direction: row; width: 100%; }
.inline-sort-cancel, .inline-sort-save { display: inline-flex; align-items: center; justify-content: center; flex: 1 1 0%; width: 0; min-width: 0; white-space: nowrap; margin: 0; padding: 0; border-radius: 999rpx; font-size: 25rpx; font-weight: 600; height: 68rpx; line-height: 68rpx; }
.inline-sort-save { margin-left: 16rpx; }
.inline-sort-cancel { color: #685E56; background: #EFEAE2; }
.inline-sort-save { color: #FFFFFF; background: linear-gradient(135deg, #E2621A 0%, #F18335 100%); }
.inline-sort-save[disabled] { color: #FFFFFF; background: #EBB58F; }
