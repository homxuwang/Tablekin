.page {
  padding-bottom: 200rpx;
}

.hero {
  background:
    radial-gradient(circle at 88% 12%, rgba(255, 224, 184, 0.34) 0%, rgba(255, 224, 184, 0) 52%),
    linear-gradient(145deg, #D95712 0%, #EA7326 60%, #F49242 100%);
  padding: 28rpx 32rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 32rpx rgba(217, 87, 18, 0.18);
}

.hero-emblem {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.52);
  box-shadow: 0 10rpx 22rpx rgba(110, 38, 6, 0.22);
}

.hero-text {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 10rpx;
  line-height: 1.5;
}

.hero-search {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.14s ease, background 0.14s ease;
}

.hero-search:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.32);
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  color: #B84C0E;
  border: 1rpx solid #F8D3B4;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 上次点菜的地方 */
.resume {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F1 100%);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #F8D8BC;
  box-shadow: 0 10rpx 28rpx rgba(223, 94, 22, 0.08);
  transition: transform 0.14s ease;
}

.resume:active {
  transform: scale(0.988);
}

.resume-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F48A3E 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.24);
}

.resume-main {
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
}

.resume-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #C77A44;
}

.resume-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF0E3;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.section-title {
  padding: 36rpx 32rpx 16rpx;
  font-size: 27rpx;
  color: #7D7168;
  font-weight: 700;
  letter-spacing: 0.6rpx;
}

.hint {
  margin: 0 24rpx;
  padding: 56rpx 32rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #8F847B;
  font-size: 27rpx;
  line-height: 1.75;
}

.hint-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ADA299;
}

/* 进行中的点单 */
.ocard {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.05);
  transition: transform 0.14s ease;
}

.ocard:active {
  transform: scale(0.988);
}

.ocard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocard-kitchen {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
}

.ocard-line {
  font-size: 26rpx;
  color: #544B44;
  margin-top: 14rpx;
  line-height: 1.5;
}

.ocard-dim {
  color: #9E938A;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.status {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
}

.st-wait {
  color: #C2670E;
  background: #FEF4E6;
}

.st-ack {
  color: #2563EB;
  background: #EDF4FF;
}

.st-doing {
  color: #158059;
  background: #EAF8F1;
}

.st-done {
  color: #685E56;
  background: #F2EFEA;
}

.st-off {
  color: #C83737;
  background: #FEEFEF;
}

/* 厨房卡片 */
.kcard {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.048);
  display: flex;
  align-items: center;
  transition: transform 0.14s ease;
}

.kcard:active {
  transform: scale(0.988);
}

.kcard-dim {
  opacity: 0.7;
}

.kcard-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 92rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(223, 94, 22, 0.22);
}

.kcard-main {
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
}

.kcard-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-tags {
  margin-top: 14rpx;
}

.tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #158059;
  background: #EAF8F1;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.kcard-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.list-foot {
  margin: 18rpx 32rpx 0;
  font-size: 23rpx;
  color: #ADA299;
  text-align: center;
  line-height: 1.7;
}

.actions {
  padding: 20rpx 32rpx 0;
}

.quick-bar {
  display: flex;
  align-items: center;
  margin: 22rpx 24rpx 0;
}

.quick-search {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  padding: 0 26rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.07);
  box-shadow: 0 6rpx 20rpx rgba(42, 28, 16, 0.04);
  display: flex;
  align-items: center;
}

.quick-search-txt {
  font-size: 26rpx;
  color: #9E938A;
  margin-left: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-join {
  flex-shrink: 0;
  margin-left: 14rpx;
  height: 82rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  background: #FFF1E5;
  color: #DF5E16;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}
