.page {
  padding-bottom: 64rpx;
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  padding: 36rpx 32rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #7D7168;
}

.hint {
  margin: 24rpx;
  padding: 48rpx 28rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #9E938A;
  font-size: 26rpx;
}

.panel {
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.045);
  margin: 0 24rpx;
  overflow: hidden;
}

.field-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.field-hint {
  font-size: 23rpx;
  color: #9E938A;
  line-height: 1.6;
}

.panel switch {
  transform: scale(0.85);
}

.actions {
  padding: 40rpx 32rpx 0;
}

.actions .btn-primary,
.actions .btn-danger,
.actions .btn-ghost {
  margin-bottom: 20rpx;
}
