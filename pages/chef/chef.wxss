.page {
  padding-bottom: 200rpx;
}

.top-head {
  padding: 20rpx 28rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.top-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.top-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #1F1A17;
  letter-spacing: -0.5rpx;
}

.top-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
}

.top-add {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 12rpx 26rpx;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.25);
  transition: transform 0.14s ease;
}

.top-add:active {
  transform: scale(0.94);
}

.banner {
  margin: 22rpx 24rpx 0;
  padding: 22rpx 26rpx;
  background: #FFF3E8;
  border: 1rpx solid #F8D3B4;
  color: #B84C0E;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 后厨待办黑金控制台 */
.dock {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 22rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 86% 15%, rgba(242, 134, 54, 0.34) 0%, rgba(242, 134, 54, 0) 56%),
    linear-gradient(135deg, #27201C 0%, #3A2E27 100%);
  box-shadow: 0 16rpx 36rpx rgba(31, 22, 16, 0.18);
  transition: transform 0.14s ease;
}

.dock:active {
  transform: scale(0.985);
}

.dock-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dock-kicker {
  font-size: 21rpx;
  font-weight: 600;
  color: #F4A96B;
  letter-spacing: 1rpx;
}

.dock-metrics {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.dock-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.dock-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-left: 8rpx;
}

.dock-sep {
  color: rgba(255, 255, 255, 0.36);
  margin: 0 14rpx;
}

.dock-cta {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.34);
  flex-shrink: 0;
}

.dock-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.dock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.dock-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.dock-text {
  font-size: 23rpx;
  color: #F8C496;
}

.sec-head {
  padding: 36rpx 28rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.sec-count {
  font-size: 23rpx;
  color: #9E938A;
}

.hint {
  margin: 0 24rpx;
  padding: 56rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #8F847B;
  font-size: 27rpx;
  line-height: 1.75;
}

.hint-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ADA299;
}

.kcard {
  margin: 0 24rpx 22rpx;
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(42, 28, 16, 0.05);
}

.kcard-head {
  display: flex;
  align-items: center;
}

.kcard-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.22);
}

.kcard-main {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.kcard-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.kcard-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1A17;
}

.kcard-sub {
  font-size: 23rpx;
  color: #8A7E74;
  margin-top: 6rpx;
}

.tag {
  margin-left: 10rpx;
  padding: 3rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  border-radius: 999rpx;
}

.share-pill {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 54rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF4EB;
  border: 1.5rpx solid #F4CCB0;
  border-radius: 999rpx;
}

/* Bento 功能块 */
.bento {
  display: flex;
  margin-top: 24rpx;
}

.bento-item {
  flex: 1.15;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.14s ease;
}

.bento-item:active {
  transform: scale(0.97);
}

.bento-main {
  background: linear-gradient(135deg, #FFF3E7 0%, #FFE4CC 100%);
  border: 1rpx solid #F6CFAF;
  margin-right: 14rpx;
}

.bento-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #B84C0E;
}

.bento-sub {
  font-size: 22rpx;
  color: #966640;
  margin-top: 10rpx;
  line-height: 1.45;
}

.bento-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.bento-mini {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FAF7F2;
  border: 1rpx solid #EFE8DF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.14s ease;
}

.bento-mini:active {
  transform: scale(0.96);
}

.bento-mini + .bento-mini {
  margin-top: 12rpx;
}

.bento-mini-t {
  font-size: 25rpx;
  font-weight: 600;
  color: #1F1A17;
}

.bento-mini-a {
  font-size: 26rpx;
  color: #9E938A;
}

/* 底部双列操作栏 */
.actions-row {
  display: flex;
  padding: 16rpx 24rpx 0;
}

.act-btn {
  flex: 1;
  padding: 26rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.14s ease;
}

.act-btn:active {
  transform: scale(0.97);
}

.act-primary {
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 22rpx rgba(223, 94, 22, 0.25);
  margin-right: 16rpx;
}

.act-ghost {
  background: #FFFFFF;
  color: #DF5E16;
  border: 2rpx solid #F3CDB0;
}

.foot-hint {
  margin: 30rpx 24rpx 0;
  font-size: 23rpx;
  color: #ADA299;
  text-align: center;
}
