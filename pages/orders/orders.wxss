.page {
  padding-bottom: 160rpx;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  padding: 8rpx 24rpx 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6B727B;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: #F2F3F6;
}

.tab + .tab {
  margin-left: 16rpx;
}

.tab-on {
  background: #FDEEE2;
  color: #E86A17;
  font-weight: 600;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 24rpx 12rpx;
  background: #FFFFFF;
}

.filter {
  font-size: 23rpx;
  color: #6B727B;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EA;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}

.filter-on {
  color: #E86A17;
  border-color: #F3C9A8;
  background: #FFF7F1;
}

.banner {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FDECEC;
  color: #C0392B;
  border-radius: 14rpx;
  font-size: 26rpx;
}

/* 站内未读提醒：新点单、接单、撤回等订单动态（平台不发微信推送，只做站内） */
.notice-strip {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background: #F2F8F4;
  border: 2rpx solid #CFE7D8;
  border-radius: 20rpx;
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2F6B4A;
}

.notice-btn {
  font-size: 24rpx;
  color: #2F6B4A;
  border: 2rpx solid #B9DCC7;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.notice-line {
  margin-top: 16rpx;
}

.notice-what {
  font-size: 26rpx;
  color: #23282F;
}

.notice-body {
  font-size: 23rpx;
  color: #6B7683;
  margin-top: 6rpx;
  line-height: 1.5;
}

.hint {
  margin: 24rpx;
  padding: 48rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  color: #9AA1A9;
  font-size: 26rpx;
  line-height: 1.7;
}

.hint-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B4B9C0;
}

.alert {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFF8F1;
  border-radius: 20rpx;
  border: 2rpx solid #FBE0CB;
}

.alert-title {
  font-size: 27rpx;
  color: #B4610F;
  font-weight: 600;
}

.alert-line {
  margin-top: 16rpx;
}

.alert-who {
  font-size: 26rpx;
  color: #23282F;
}

.alert-why {
  font-size: 23rpx;
  color: #9AA1A9;
  margin-top: 6rpx;
}

.alert-btn {
  margin-top: 20rpx;
  text-align: right;
  font-size: 25rpx;
  color: #E86A17;
}

.order {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-who {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
}

.status {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.st-wait {
  color: #B4610F;
  background: #FFF4E8;
}

.st-ack {
  color: #1D6FA5;
  background: #EAF3FB;
}

.st-doing {
  color: #1D9E75;
  background: #E9F7F1;
}

.st-done {
  color: #5C646E;
  background: #EFF1F4;
}

.st-off {
  color: #A32D2D;
  background: #FCEBEB;
}

.order-line {
  font-size: 25rpx;
  color: #5C646E;
  margin-top: 14rpx;
}

.order-items {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #F1F2F4;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.dish-name {
  font-size: 27rpx;
  color: #23282F;
}

.dish-qty {
  font-size: 25rpx;
  color: #8A9099;
}

.order-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6B727B;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

.order-note-red {
  color: #A32D2D;
  background: #FCEBEB;
}

.order-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 23rpx;
  color: #A6ACB4;
}

.order-tools {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.tool {
  font-size: 24rpx;
  color: #6B727B;
  border: 2rpx solid #E5E7EA;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-left: 14rpx;
}

.tool-main {
  color: #FFFFFF;
  background: #E86A17;
  border-color: #E86A17;
}

.tool-soft {
  color: #1D6FA5;
  border-color: #C9DEF1;
  background: #F4F9FE;
}

.tool-danger {
  color: #D64545;
  border-color: #F2C4C4;
}

.list-foot {
  margin: 24rpx 24rpx 0;
  font-size: 23rpx;
  color: #A6ACB4;
  text-align: center;
}

.actions {
  padding: 8rpx 32rpx 0;
}

.notice-strip { margin: 20rpx 24rpx; padding: 24rpx; border-radius: 20rpx; background: #FFF7F1; }
.notice-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.notice-title { font-size: 28rpx; font-weight: 600; color: #23282F; }
.notice-btn { font-size: 24rpx; color: #E86A17; padding: 12rpx 0; }
.notice-line { padding: 20rpx 0; border-top: 2rpx solid #F3E4D8; }
.notice-what { font-size: 28rpx; color: #23282F; }
.notice-body { font-size: 24rpx; color: #6B727B; margin-top: 8rpx; line-height: 1.6; }
