.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx 20rpx;
  background: #FFFFFF;
}

.box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 26rpx;
  background: #F5F1EB;
  border-radius: 999rpx;
}

.box-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F1A17;
  padding: 0 14rpx;
}

.box-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #CFC7BE;
  color: #FFFFFF;
  font-size: 28rpx;
}

.cancel {
  flex-shrink: 0;
  padding-left: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #DF5E16;
}

.tabs-wrap {
  background: #FFFFFF;
  padding: 0 24rpx 22rpx;
  border-bottom: 1rpx solid rgba(60, 42, 24, 0.06);
}

.tabs-track {
  display: flex;
  background: #F1ECE4;
  border-radius: 999rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 500;
  color: #7D7168;
  padding: 14rpx 0;
  border-radius: 999rpx;
  transition: all 0.16s ease;
}

.tab-on {
  background: #FFFFFF;
  color: #1F1A17;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(42, 28, 16, 0.08);
}

.history-card {
  margin: 16rpx 24rpx 0;
  padding: 22rpx 24rpx 12rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 6rpx 20rpx rgba(42, 28, 16, 0.035);
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F1A17;
}

.history-clear {
  font-size: 23rpx;
  color: #9E938A;
}

.history-row {
  display: flex;
  flex-wrap: wrap;
}

.history-chip {
  font-size: 24rpx;
  color: #5C534C;
  background: #F5F1EB;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
}

.scopes {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 4rpx;
}

.scope {
  font-size: 24rpx;
  font-weight: 500;
  color: #685E56;
  background: #FFFFFF;
  border: 1.5rpx solid #E7DFD6;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 0 14rpx 12rpx 0;
}

.scope-on {
  color: #DF5E16;
  font-weight: 600;
  border-color: #F4CCB0;
  background: #FFF3E8;
}

/* ---------- 标签筛选 ---------- */

.tagbar {
  margin: 14rpx 24rpx 0;
  padding: 24rpx 24rpx 14rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(42, 28, 16, 0.04);
}

.tagbar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.tagbar-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1F1A17;
}

.tagmodes {
  display: flex;
}

.tagmode {
  font-size: 22rpx;
  font-weight: 500;
  color: #7D7168;
  background: #F4EFE8;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.tagmode + .tagmode {
  margin-left: 12rpx;
}

.tagmode-on {
  color: #DF5E16;
  background: #FFF0E3;
  font-weight: 600;
}

.tagbar-row {
  display: flex;
  flex-wrap: wrap;
}

.tagpick {
  font-size: 24rpx;
  color: #685E56;
  background: #F5F1EB;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
}

.tagpick-on {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #E2621A 0%, #F18335 100%);
  box-shadow: 0 6rpx 16rpx rgba(223, 94, 22, 0.24);
}

.tagpick-on .tagpick-count {
  color: #FFE4CE;
}

.tagpick-count {
  font-size: 20rpx;
  color: #9E938A;
  margin-left: 8rpx;
}

.dcard-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.dtag {
  font-size: 20rpx;
  font-weight: 500;
  color: #DF5E16;
  background: #FFF2E6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 0 8rpx 8rpx 0;
}

.banner {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FEF0F0;
  border: 1rpx solid #F8CBCB;
  color: #C83737;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.hint {
  margin: 24rpx;
  padding: 56rpx 32rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.04);
  text-align: center;
  color: #8F847B;
  font-size: 27rpx;
  line-height: 1.75;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #F4EFE8;
}

.thumb-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF3E6 0%, #FCE1C8 100%);
  color: #DF5E16;
  font-size: 46rpx;
  font-weight: 700;
}

.dcard {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.045);
  display: flex;
  align-items: center;
}

.dcard-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.dcard-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
}

.dcard-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dcard-meta {
  font-size: 22rpx;
  color: #9E938A;
  margin-top: 10rpx;
}

.dcard-meta .dim {
  margin-left: 12rpx;
  color: #C83737;
}

.dcard-go {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.kcard {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 1rpx solid rgba(60, 42, 24, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(42, 28, 16, 0.045);
  display: flex;
  align-items: center;
}

.kcard-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #F69247 0%, #DF5E16 100%);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(223, 94, 22, 0.22);
}

.kcard-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.kcard-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F1A17;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.kcard-sub {
  font-size: 24rpx;
  color: #8A7E74;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kcard-go {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.tag {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #DF5E16;
  background: #FFF1E5;
  border-radius: 999rpx;
}

.tag-soft {
  color: #685E56;
  background: #F4EFE8;
}
