.page {
  min-height: 100vh;
  padding: 24rpx 0 200rpx;
  background: #F5F6F8;
}

.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid #F1F2F4;
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 30rpx;
  color: #23282F;
  flex: 1;
  padding-right: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF1E6;
  color: #E86A17;
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  color: #23282F;
}

.field-textarea.short {
  min-height: 96rpx;
}

.summary-card {
  background: #23282F;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
}

.summary-title {
  color: #B9BFC7;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.summary-body {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.actions {
  padding: 12rpx 24rpx 0;
}

.actions .btn-primary,
.actions .btn-ghost,
.actions .btn-danger {
  margin-bottom: 20rpx;
}

.warn-card {
  background: #FFF4E8;
  border: 2rpx solid #F8D9BC;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 26rpx 30rpx;
}

.warn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #B4610F;
}

.warn-line {
  margin-top: 16rpx;
}

.warn-ing {
  font-size: 28rpx;
  color: #23282F;
}

.warn-detail {
  font-size: 24rpx;
  color: #B4610F;
  margin-top: 6rpx;
  line-height: 1.6;
}

.panel-title {
  font-size: 26rpx;
  color: #8A9099;
  padding: 26rpx 30rpx 6rpx;
}

/* 就餐时间 */
.date-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx 8rpx; font-size: 28rpx; color: #6B727B; }
.date-value { color: #23282F; font-weight: 600; }
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 30rpx 4rpx;
}

.chip {
  font-size: 26rpx;
  color: #6B727B;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EA;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 16rpx 12rpx 0;
}

.chip-on {
  color: #E86A17;
  border-color: #F3C9A8;
  background: #FFF7F1;
  font-weight: 600;
}

.time-row {
  display: flex;
  align-items: center;
  padding: 12rpx 30rpx 0;
}

.time-box {
  background: #F5F6F8;
  border-radius: 14rpx;
  padding: 18rpx 34rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #23282F;
}

.time-sep {
  font-size: 26rpx;
  color: #8A9099;
  padding: 0 18rpx;
}

.time-clear {
  font-size: 24rpx;
  color: #E86A17;
  margin-left: 20rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 30rpx 0;
}

.quick-chip {
  font-size: 24rpx;
  color: #6B727B;
  background: #F5F6F8;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 0 14rpx 12rpx 0;
}

.quick-on {
  color: #E86A17;
  background: #FDEEE2;
}

.time-hint {
  font-size: 24rpx;
  color: #A6ACB4;
  padding: 8rpx 30rpx 26rpx;
}

/* 底部发送条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 2rpx solid #EDEEF1;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bb-left {
  flex: 1;
  min-width: 0;
}

.bb-total {
  font-size: 30rpx;
  font-weight: 600;
  color: #23282F;
}

.bb-sub {
  font-size: 23rpx;
  color: #A6ACB4;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bb-btn {
  flex-shrink: 0;
  background: #E86A17;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 22rpx 46rpx;
  margin-left: 24rpx;
}

.bb-btn.disabled {
  opacity: 0.45;
}
