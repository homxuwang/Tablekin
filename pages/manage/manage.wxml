<template name="inlineSorter">
  <view class="inline-sort-help">长按 ☰ 拖动，完成后保存</view>
  <view wx:if="{{sortError}}" class="inline-sort-error">{{sortError}} <text bindtap="sortReload">重新加载</text></view>
  <scroll-view class="inline-sort-scroll" scroll-y="{{true}}" scroll-top="{{sortScrollTop}}" scroll-with-animation="{{false}}" bindscroll="sortOnScroll">
    <view wx:if="{{sortItems.length === 0}}" class="hint">暂无可排序的项目</view>
    <view class="inline-sort-row {{sortDragging && sortDragId == item.id ? 'inline-sort-placeholder' : ''}}" wx:for="{{sortItems}}" wx:key="id">
      <view class="inline-sort-handle" data-id="{{item.id}}" bindtouchstart="sortTouchStart" bindlongpress="sortStartDrag" catchtouchmove="sortTouchMove" bindtouchend="sortEndDrag" bindtouchcancel="sortCancelDrag">☰</view>
      <view class="inline-sort-main">
        <view class="inline-sort-name">{{item.name}}</view>
        <view class="inline-sort-tools">
          <text class="inline-sort-index">#{{index + 1}}</text>
          <button size="mini" class="inline-sort-action" disabled="{{index === 0 || sortSaving || sortDragging}}" data-id="{{item.id}}" bindtap="sortTop">置顶</button>
          <button size="mini" class="inline-sort-action" disabled="{{index === sortItems.length - 1 || sortSaving || sortDragging}}" data-id="{{item.id}}" bindtap="sortBottom">置底</button>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="inline-sort-footer">
    <view class="inline-sort-status">{{sortDirty ? '待保存' : '未调整'}}</view>
    <view class="inline-sort-buttons">
      <button size="mini" class="inline-sort-cancel" disabled="{{sortSaving || sortDragging}}" bindtap="sortCancel">取消</button>
      <button size="mini" class="inline-sort-save" disabled="{{!sortDirty || sortSaving || sortDragging}}" bindtap="sortSave">{{sortSaving ? '保存中…' : '保存'}}</button>
    </view>
  </view>
</template>

<view class="page">
  <view class="top-head">
    <view class="top-main">
      <view class="top-title">{{kitchen.name || '厨房管理'}}</view>
      <view class="top-sub">
        {{total}} 道菜 · {{publicCount}} 道已公开 · {{memberCount}} 位成员
      </view>
    </view>
    <view class="top-preview" bindtap="goMenu">预览菜单</view>
  </view>

  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view class="kpi-grid">
    <view class="kpi-card {{pendingCount > 0 ? 'kpi-hot' : ''}}" bindtap="goOrders">
      <view class="kpi-num">{{pendingCount}}</view>
      <view class="kpi-label">待接单</view>
    </view>
    <view class="kpi-card {{alertCount > 0 ? 'kpi-warn' : ''}}" bindtap="goOrders">
      <view class="kpi-num">{{alertCount}}</view>
      <view class="kpi-label">缺料提醒</view>
    </view>
    <view class="kpi-card" bindtap="goIngredients">
      <view class="kpi-num">{{ingredientCount}}</view>
      <view class="kpi-label">食材仓库</view>
    </view>
  </view>

  <view wx:if="{{lowIngredientCount > 0}}" class="alert" bindtap="goIngredients">
    该补货了（{{lowIngredientCount}} 种）：{{lowIngredientNames}} ›
  </view>

  <view class="section-title">协作</view>
  <view class="panel">
    <view class="cell" bindtap="goMembers">
      <view class="cell-main">
        <view class="cell-title">成员与邀请</view>
        <view class="cell-sub">
          共 {{memberCount}} 人<block wx:if="{{isOwner}}"> · 分享链接邀请共有人</block><block wx:else> · 你是这个厨房的共有人</block>
        </view>
      </view>
      <view class="cell-go">管理</view>
    </view>
    <view wx:if="{{isOwner}}" class="cell" bindtap="goSettings">
      <view class="cell-main">
        <view class="cell-title">厨房资料</view>
        <view class="cell-sub">
          名称、简介{{isOwner ? '、是否公开' : ''}}
        </view>
      </view>
      <view class="cell-go">修改</view>
    </view>
  </view>

  <view class="section-title section-sort"><text>菜品分类</text><view class="sort-entry" data-kind="categories" bindtap="openSort">{{sortKind === 'categories' ? '正在调整' : '调整顺序 ↕'}}</view></view>
  <view class="panel">
    <template wx:if="{{sortKind === 'categories'}}" is="inlineSorter" data="{{sortItems: sortItems, sortError: sortError, sortScrollTop: sortScrollTop, sortDragging: sortDragging, sortDragId: sortDragId, sortSaving: sortSaving, sortDirty: sortDirty}}"></template>
    <block wx:else>
    <view wx:if="{{categories.length === 0}}" class="hint">还没有分类，先加一个「凉菜」试试</view>
    <view class="cat-row" wx:for="{{categories}}" wx:key="id">
      <view class="cat-name">{{item.name}}</view>
      <view class="cat-tools">
        <switch
          checked="{{item.is_public}}"
          disabled="{{!!sortKind || categoryBusy}}"
          data-id="{{item.id}}"
          bindchange="toggleCategoryPublic"
          color="#E86A17"
        />
        <view class="cat-del" bindtap="removeCategory" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view class="add-cat">
      <input
        class="add-cat-input"
        value="{{newCategoryName}}"
        disabled="{{!!sortKind || categoryBusy || addingCategory}}"
        bindinput="onNewCategoryInput"
        placeholder="新分类名称，如「卤菜」"
        maxlength="12"
      />
      <view class="add-cat-btn" bindtap="addCategory">添加</view>
    </view>
    <view class="panel-foot">分类右侧的开关控制它是否出现在公开菜单里</view>
    </block>
  </view>

  <view class="section-title section-sort"><text>菜品</text><view class="sort-entry" data-kind="dishes" bindtap="openSort">{{sortKind === 'dishes' ? '正在调整' : '调整顺序 ↕'}}</view></view>
  <view class="panel">
    <template wx:if="{{sortKind === 'dishes'}}" is="inlineSorter" data="{{sortItems: sortItems, sortError: sortError, sortScrollTop: sortScrollTop, sortDragging: sortDragging, sortDragId: sortDragId, sortSaving: sortSaving, sortDirty: sortDirty}}"></template>
    <block wx:else>
    <view wx:if="{{loading}}" class="hint">正在加载…</view>
    <view wx:elif="{{dishes.length === 0}}" class="hint">还没有菜品，点下面的「新增菜品」开始录入</view>
    <view
      class="dish-row"
      wx:for="{{dishes}}"
      wx:key="id"
      bindtap="openDish"
      data-id="{{item.id}}"
    >
      <view class="dish-row-main">
        <view class="dish-row-name">{{item.name}}</view>
        <view class="dish-row-tags">
          <text class="mini-tag">{{item.is_public ? '菜单公开' : '仅成员可见'}}</text>
          <text class="mini-tag">{{item.recipe ? '有菜谱' : '无菜谱'}}</text>
          <text wx:if="{{!item.is_available}}" class="mini-tag mini-tag-off">已下架</text>
        </view>
      </view>
      <view class="dish-row-go">编辑</view>
    </view>
    </block>
  </view>

  <view wx:if="{{sortDragging}}" class="inline-sort-ghost" style="top: {{sortDragTop}}px; height: {{sortDragHeight}}px;">
    <text class="inline-sort-handle">☰</text><view class="inline-sort-name">{{sortDragName}}</view>
  </view>

  <view class="actions">
    <view class="btn-primary" bindtap="newDish">+ 新增菜品</view>
    <view class="btn-ghost" bindtap="goMenu">看客人视角的菜单</view>
    <view class="btn-ghost" bindtap="goHome">回到「下厨」</view>
  </view>
</view>
